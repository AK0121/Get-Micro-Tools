---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import CalculatorHeader from '../components/instagram-engagement-calculator/CalculatorHeader.astro';
import ModeToggle from '../components/instagram-engagement-calculator/ModeToggle.astro';
import CalculatorInputs from '../components/instagram-engagement-calculator/CalculatorInputs.astro';
import ResultsConsole from '../components/instagram-engagement-calculator/ResultsConsole.astro';
import EducationalContent from '../components/instagram-engagement-calculator/EducationalContent.astro';
import CalculatorScript from '../components/instagram-engagement-calculator/CalculatorScript.astro';

const title = "Instagram Engagement Rate Calculator (ERR & ERF) | Get Micro Tools";
const description = "Calculate your Instagram Engagement Rate by Reach (ERR) and Followers (ERF). Free, instant creator-tier benchmarks, formula breakdowns, and actionable insights.";
const keywords = "instagram engagement rate calculator, ERR calculator, ERF calculator, instagram reach engagement rate, instagram creator benchmarks, instagram analytics tool, calculate instagram engagement";
const url = "https://getmicro.tools/instagram-engagement-rate-calculator";
---

<Layout 
  title={title}
  description={description} 
  keywords={keywords}
  url={url}
>
  <Nav />

  <main class="min-h-screen bg-canvas">
    {/* Header Section */}
    <CalculatorHeader />

    {/* Calculator & Analysis Card Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="bg-surface-card rounded-2xl border border-hairline overflow-hidden shadow-sm">
        
        {/* Calculation Mode Toggle Header */}
        <ModeToggle />

        {/* Main Grid: Inputs vs Results */}
        <div class="p-4 sm:p-6 md:p-8 xl:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
          
          {/* Inputs Column */}
          <CalculatorInputs />

          {/* Results Analysis Console Column */}
          <ResultsConsole />

        </div>
      </div>
    </section>

    {/* Detailed Educational & Methodological Content Section */}
    <EducationalContent />
  </main>

  <Footer />
</Layout>

<CalculatorScript />
