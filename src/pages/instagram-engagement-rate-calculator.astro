  const tierBadge = document.getElementById('tier-badge');
  const benchmarkBadge = document.getElementById('benchmark-badge');
  const benchmarkExplanation = document.getElementById('benchmark-explanation');
  const recommendationsContainer = document.getElementById('recommendations-list');
  const insightsHeading = document.getElementById('insights-heading');

  const errFormulaCard = document.getElementById('err-formula-card');
  const erfFormulaCard = document.getElementById('erf-formula-card');

  const modeButtons = Array.from(document.querySelectorAll('.calc-mode-btn')) as HTMLButtonElement[];
  const breakdownInputs = [likesInput, commentsInput, sharesInput, savesInput];
  const inputFields = [followersInput, reachInput, ...breakdownInputs];

  let activeMode = 'err';

  // Mode Switcher Handling & Keyboard Nav
  function setCalculationMode(selectedBtn: HTMLButtonElement) {
    modeButtons.forEach(btn => {
      const isSelected = btn === selectedBtn;
      btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
      btn.setAttribute('tabindex', isSelected ? '0' : '-1');
      btn.className = isSelected
        ? 'calc-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-primary bg-primary/10 text-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2 shadow-xs'
        : 'calc-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-hairline bg-surface-card text-muted hover:text-ink hover:border-hairline-strong transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2';
    });

    activeMode = selectedBtn.dataset.mode || 'err';
    updateCalculation();
  }

  modeButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => setCalculationMode(btn));

    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      let targetIndex: number | null = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        targetIndex = (index + 1) % modeButtons.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        targetIndex = (index - 1 + modeButtons.length) % modeButtons.length;
      } else if (e.key === 'Home') {
        targetIndex = 0;
      } else if (e.key === 'End') {
        targetIndex = modeButtons.length - 1;
      }

      if (targetIndex !== null) {
        e.preventDefault();
        modeButtons[targetIndex].focus();
        setCalculationMode(modeButtons[targetIndex]);
      }
    });
  });

  // Sanitizes input with validation message callbacks
  function getSanitizedValue(
    input: HTMLInputElement | null, 
    errorElem?: HTMLElement | null, 
    errorTextElem?: HTMLElement | null,
    fieldName: string = 'Value'
  ): number {
    if (!input || !input.value.trim()) {
      if (input) {
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-red-500', 'focus:ring-red-500/20');
      }
      if (errorElem) errorElem.classList.add('hidden');
      return 0;
    }

    const num = parseFloat(input.value);
    if (isNaN(num) || num < 0) {
      input.setAttribute('aria-invalid', 'true');
      input.classList.add('border-red-500', 'focus:ring-red-500/20');
      if (errorElem && errorTextElem) {
        errorTextElem.innerText = `${fieldName} must be a non-negative whole number.`;
        errorElem.classList.remove('hidden');
      }
      return 0;
    }

    input.removeAttribute('aria-invalid');
    input.classList.remove('border-red-500', 'focus:ring-red-500/20');
    if (errorElem) errorElem.classList.add('hidden');
    return Math.floor(num);
  }

  // Auto-calculates read-only Total Engagements
  function syncTotalEngagements() {
    if (!totalEngagementsInput) return;

    const likes = getSanitizedValue(likesInput, interactionsError, interactionsErrorText, 'Likes');
    const comments = getSanitizedValue(commentsInput, interactionsError, interactionsErrorText, 'Comments');
    const shares = getSanitizedValue(sharesInput, interactionsError, interactionsErrorText, 'Shares');
    const saves = getSanitizedValue(savesInput, interactionsError, interactionsErrorText, 'Saves');
    
    const sum = likes + comments + shares + saves;
    const hasAnyInput = breakdownInputs.some(input => input && input.value.trim() !== '');

    totalEngagementsInput.value = hasAnyInput ? sum.toString() : '0';
  }

  // Resets calculator client-side
  function resetCalculator() {
    inputFields.forEach(input => {
      if (input) {
        input.value = '';
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-red-500', 'focus:ring-red-500/20');
      }
    });

    if (totalEngagementsInput) {
      totalEngagementsInput.value = '0';
    }

    if (followersError) followersError.classList.add('hidden');
    if (reachError) reachError.classList.add('hidden');
    if (interactionsError) interactionsError.classList.add('hidden');
    if (inputWarningBanner) {
      inputWarningBanner.innerHTML = '';
      inputWarningBanner.classList.add('hidden');
    }

    updateCalculation();
    followersInput?.focus();
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', resetCalculator);
  }

  function updateCalculation() {
    syncTotalEngagements();

    const followers = getSanitizedValue(followersInput, followersError, followersErrorText, 'Total Followers');
    const reach = getSanitizedValue(reachInput, reachError, reachErrorText, 'Accounts Reached');
    const likes = getSanitizedValue(likesInput, interactionsError, interactionsErrorText, 'Likes');
    const comments = getSanitizedValue(commentsInput, interactionsError, interactionsErrorText, 'Comments');
    const shares = getSanitizedValue(sharesInput, interactionsError, interactionsErrorText, 'Shares');
    const saves = getSanitizedValue(savesInput, interactionsError, interactionsErrorText, 'Saves');

    const total = likes + comments + shares + saves;
    const isERR = activeMode === 'err';
    const denominator = isERR ? reach : followers;

    const hasEnteredInput = inputFields.some(input => input && input.value.trim() !== '');
    const hasEnteredDenominator = isERR ? (reachInput && reachInput.value.trim() !== '') : (followersInput && followersInput.value.trim() !== '');

    // Rates calculation (client-side)
    const err = calculateERR(total, reach);
    const erf = calculateERF(total, followers);

    const primaryRate = isERR ? err : erf;
    const secondaryRate = isERR ? erf : err;

    // Creator Tier & Benchmark Rating
    const tier = getCreatorTier(followers);
    const benchmark = evaluateBenchmark(primaryRate, followers, denominator, activeMode);

    // Dynamic non-blocking warnings for unrealistic inputs
    const inputWarnings: string[] = [];

    if (total > 0) {
      if (isERR && reach > 0 && total > reach) {
        inputWarnings.push(`⚠️ <strong>Unrealistic Ratio:</strong> Total engagements (${total.toLocaleString()}) exceed Accounts Reached (${reach.toLocaleString()}). Please double-check your Insights.`);
      } else if (!isERR && followers > 0 && total > followers) {
        inputWarnings.push(`⚠️ <strong>High Follower Conversion:</strong> Total engagements (${total.toLocaleString()}) exceed Total Followers (${followers.toLocaleString()}). Non-follower reach may be driving interactions.`);
      }

      if (isERR && reach === 0) {
        inputWarnings.push(`⚠️ <strong>Missing Reach:</strong> You entered interactions, but <strong>Accounts Reached</strong> is 0. Enter reach above to calculate ERR.`);
      } else if (!isERR && followers === 0) {
        inputWarnings.push(`⚠️ <strong>Missing Followers:</strong> You entered interactions, but <strong>Total Followers</strong> is 0. Enter followers above to calculate ERF.`);
      }

      if (primaryRate > 50) {
        inputWarnings.push(`⚠️ <strong>Unusually High Rate:</strong> Calculated ${isERR ? 'ERR' : 'ERF'} is <strong>${primaryRate.toFixed(2)}%</strong>. Engagement rates over 50% are rare — verify reach and interaction metrics.`);
      }
    }

    // Display non-blocking warnings banner
    if (inputWarningBanner) {
      if (inputWarnings.length > 0) {
        inputWarningBanner.innerHTML = inputWarnings.map(w => `<p class="leading-normal">${w}</p>`).join('');
        inputWarningBanner.classList.remove('hidden');
      } else {
        inputWarningBanner.innerHTML = '';
        inputWarningBanner.classList.add('hidden');
      }
    }

    // Ratios
    const saveLikeRatio = likes > 0 ? ((saves / likes) * 100).toFixed(1) : (hasEnteredInput && likes > 0 ? '0.0' : '--');
    const shareLikeRatio = likes > 0 ? ((shares / likes) * 100).toFixed(1) : (hasEnteredInput && likes > 0 ? '0.0' : '--');

    // Recommendations
    const recs = generateRecommendations({
      likes, comments, shares, saves, totalEngagements: total, reach, followers, mode: activeMode
    });

    // Update DOM Elements
    if (primaryMetricLabel) {
      primaryMetricLabel.innerText = isERR ? 'Engagement Rate by Reach (ERR)' : 'Engagement Rate by Followers (ERF)';
    }

    if (primaryMetricValue) {
      primaryMetricValue.innerText = (hasEnteredDenominator && total > 0) ? primaryRate.toFixed(2) : '--';
    }

    if (activeFormulaDisplay) {
      activeFormulaDisplay.innerText = isERR
        ? 'Formula: ERR = (Engagements / Reach) × 100'
        : 'Formula: ERF = (Engagements / Followers) × 100';
    }

    if (secondaryMetricLabel) {
      secondaryMetricLabel.innerText = isERR ? 'ER by Followers (ERF)' : 'ER by Reach (ERR)';
    }

    if (secondaryMetricValue) {
      secondaryMetricValue.innerText = (hasEnteredInput && secondaryRate > 0) ? `${secondaryRate.toFixed(2)}%` : '--';
    }

    if (totalEngagementsDisplay) {
      totalEngagementsDisplay.innerText = total.toLocaleString();
    }

    if (saveLikeRatioDisplay) {
      saveLikeRatioDisplay.innerText = saveLikeRatio === '--' ? '--' : `${saveLikeRatio}%`;
    }

    if (shareLikeRatioDisplay) {
      shareLikeRatioDisplay.innerText = shareLikeRatio === '--' ? '--' : `${shareLikeRatio}%`;
    }

    if (tierBadge) {
      tierBadge.innerText = followers > 0 ? `${tier.label} (${tier.range})` : 'Nano Creator (< 10k)';
    }

    if (benchmarkBadge) {
      if (!hasEnteredDenominator || total === 0) {
        benchmarkBadge.innerText = 'Awaiting Data';
        benchmarkBadge.className = 'flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-pill font-semibold text-xs uppercase tracking-wider border transition-all mx-auto max-w-max shadow-2xs bg-surface-strong text-muted border-hairline';
      } else {
        benchmarkBadge.innerText = benchmark.label;
        benchmarkBadge.className = `flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-pill font-semibold text-xs uppercase tracking-wider border transition-all mx-auto max-w-max shadow-2xs ${benchmark.badgeClass}`;
      }
    }

    if (benchmarkExplanation) {
      if (!hasEnteredDenominator || total === 0) {
        benchmarkExplanation.innerText = isERR 
          ? 'Enter post reach & interactions above to compute ERR and evaluate against your tier standard.' 
          : 'Enter total followers & interactions above to compute ERF and evaluate against your tier standard.';
      } else {
        benchmarkExplanation.innerText = benchmark.description;
      }
    }

    if (insightsHeading) {
      insightsHeading.innerText = isERR ? 'ERR Performance Insights' : 'ERF Performance Insights';
    }

    // Highlight active formula card
    if (errFormulaCard && erfFormulaCard) {
      if (isERR) {
        errFormulaCard.className = 'p-6 bg-surface-card rounded-xl border-2 border-primary space-y-3 transition-all shadow-xs';
        erfFormulaCard.className = 'p-6 bg-surface-card rounded-xl border border-hairline space-y-3 transition-all opacity-80 shadow-xs';
      } else {
        errFormulaCard.className = 'p-6 bg-surface-card rounded-xl border border-hairline space-y-3 transition-all opacity-80 shadow-xs';
        erfFormulaCard.className = 'p-6 bg-surface-card rounded-xl border-2 border-primary space-y-3 transition-all shadow-xs';
      }
    }

    // Render Recommendations or Empty State
    if (recommendationsContainer) {
      if (!hasEnteredInput && total === 0) {
        recommendationsContainer.innerHTML = `
          <div class="p-4 rounded-xl bg-surface-card border border-hairline text-xs space-y-2.5">
            <div class="flex items-center gap-2 text-ink font-semibold">
              <span class="text-sm">🎯</span>
              <span>Ready for Analysis</span>
            </div>
            <p class="text-muted text-[11px] leading-relaxed">
              Fill in your post data to generate real-time performance insights:
            </p>
            <ul class="text-muted text-[11px] space-y-1.5 list-disc pl-4 leading-relaxed">
              <li><strong>Select Mode:</strong> Choose <strong>ERR</strong> for post reach & Reels or <strong>ERF</strong> for profile audit.</li>
              <li><strong>Input Audience Base:</strong> Enter your Accounts Reached or Total Followers.</li>
              <li><strong>Add Interactions:</strong> Enter your Likes, Comments, Shares, and Saves.</li>
            </ul>
          </div>
        `;
      } else {
        recommendationsContainer.innerHTML = recs.map(rec => {
          let badgeStyle = 'bg-primary/10 text-primary border-primary/20';
          let icon = '💡';
          if (rec.type === 'success') {
            badgeStyle = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20';
            icon = '🚀';
          } else if (rec.type === 'warning') {
            badgeStyle = 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20';
            icon = '⚠️';
          } else if (rec.type === 'tip') {
            badgeStyle = 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20';
            icon = '📈';
          }

          return `
            <div class="p-3.5 rounded-lg border text-xs leading-relaxed transition-all ${badgeStyle}">
              <div class="font-semibold flex items-center gap-1.5 mb-1 text-ink">
                <span>${icon}</span>
                <span>${rec.title}</span>
              </div>
              <p class="text-muted dark:text-gray-300 font-normal leading-normal">${rec.text}</p>
            </div>
          `;
        }).join('');
      }
    }
  }

  // Event listeners for real-time calculations
  inputFields.forEach(input => {
    if (input) {
      input.addEventListener('input', () => updateCalculation());
      input.addEventListener('change', () => {
        if (input.value && parseFloat(input.value) < 0) {
          input.value = '0';
        }
        updateCalculation();
      });
    }
  });

  // Initial calculation run
  updateCalculation();
</script>

<style>
  /* Input number spin button clean-up */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type=number] {
    -moz-appearance: textfield;
  }
</style>

