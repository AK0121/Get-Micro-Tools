---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

import CalculatorHeader from '../components/instagram-engagement-calculator/CalculatorHeader.astro';
import ModeToggle from '../components/instagram-engagement-calculator/ModeToggle.astro';
import CalculatorInputs from '../components/instagram-engagement-calculator/CalculatorInputs.astro';
import ResultsConsole from '../components/instagram-engagement-calculator/ResultsConsole.astro';
import EducationalContent from '../components/instagram-engagement-calculator/EducationalContent.astro';
import CalculatorScript from '../components/instagram-engagement-calculator/CalculatorScript.astro';

const title = "Instagram Engagement Rate Calculator (ERR & ERF) | Get Micro Tools";
const description = "Calculate your Instagram Engagement Rate by Reach (ERR) or Followers (ERF). Free client-side tool with verified formulas, creator tier benchmarks, and campaign analysis.";
const keywords = "instagram engagement rate calculator, ERR calculator, ERF calculator, instagram reach engagement rate, calculate instagram engagement, instagram creator tier benchmarks";
const url = "https://getmicrotools.com/instagram-engagement-rate-calculator";

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Instagram Engagement Rate Calculator",
  "alternateName": [
    "Instagram ERR Calculator",
    "Instagram ERF Calculator",
    "Instagram Engagement Calculator"
  ],
  "url": "https://getmicrotools.com/instagram-engagement-rate-calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": "Calculate Instagram Engagement Rate by Reach (ERR) and by Followers (ERF). Features real-time creator tier benchmarking, save-to-like ratios, and campaign evaluation tools.",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Get Micro Tools",
    "url": "https://getmicrotools.com"
  },
  "featureList": [
    "Engagement Rate by Reach (ERR) calculation",
    "Engagement Rate by Followers (ERF) calculation",
    "Automatic sum of Likes, Comments, Shares, and Saves",
    "Save-to-Like and Share-to-Like intent ratios",
    "Creator tier detection from Nano to Mega",
    "100% private, client-side browser execution"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getmicrotools.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Instagram Engagement Rate Calculator",
      "item": "https://getmicrotools.com/instagram-engagement-rate-calculator"
    }
  ]
};
---

<Layout 
  title={title}
  description={description} 
  keywords={keywords}
  url={url}
>
  <Nav />

  <main class="min-h-screen bg-canvas">
    {/* Header Section */}
    <CalculatorHeader />

    {/* Calculator & Analysis Card Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="bg-surface-card rounded-2xl border border-hairline overflow-hidden shadow-sm">
        
        {/* Calculation Mode Toggle Header */}
        <ModeToggle />

        {/* Main Grid: Inputs vs Results */}
        <div class="p-4 sm:p-6 md:p-8 xl:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
          
          {/* Inputs Column */}
          <CalculatorInputs />

          {/* Results Analysis Console Column */}
          <ResultsConsole />

        </div>
      </div>
    </section>

    {/* Detailed Educational & Methodological Content Section */}
    <EducationalContent />
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<CalculatorScript />
