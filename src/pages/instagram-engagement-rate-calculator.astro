---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';

const faqs = [
  {
    question: "What is Instagram Engagement Rate?",
    answer: "Instagram Engagement Rate is the quantitative percentage of an audience (Reach or Followers) that actively interacts with your content through Likes, Comments, Shares, and Saves. Unlike raw follower counts, engagement rate measures true content resonance, audience loyalty, and algorithmic performance."
  },
  {
    question: "What is Engagement Rate by Reach (ERR) vs. Engagement Rate by Followers (ERF)?",
    answer: "ERR measures the percentage of unique accounts who saw your post and engaged with it (Total Engagements / Reach × 100). ERF measures engagement against your total follower count (Total Engagements / Followers × 100). ERR is the true indicator of content quality and Reels virality, while ERF is traditionally used by agencies to audit overall account authority."
  },
  {
    question: "Which engagement rate formula do brands and agencies use?",
    answer: "Traditionally, brand agencies use ERF for quick influencer vetting because follower count is publicly visible without backend dashboard access. However, performance-driven brands and sponsors now request ERR (or post Reach screenshots) for paid creator campaigns to evaluate actual impression conversion rates."
  },
  {
    question: "Which engagement rate formula should creators track?",
    answer: "Creators should primarily track ERR (Engagement Rate by Reach). ERR isolates content performance from Instagram's distribution algorithm. When a Reel or Carousel goes viral to non-followers, ERR shows how effectively your hook and value proposition converted viewers into active engagement."
  },
  {
    question: "What is a good Instagram engagement rate in 2026?",
    answer: "A good engagement rate depends on your creator tier and chosen metric. For Nano creators (<10k followers), 4.0%–7.0% ERR (or 2.0%–5.0% ERF) is standard. For Micro creators (10k–50k), 2.5%–4.5% ERR (1.5%–3.0% ERF) is healthy. Larger tiers naturally scale down because reach distribution broadens."
  },
  {
    question: "Why are Shares and Saves so important on Instagram?",
    answer: "Instagram's recommendation algorithm prioritizes high-intent actions. Shares (DMs/Sends) indicate content virality and drive non-follower reach on Explore and Reels. Saves (Bookmarks) signal high value and utility. Both actions carry significantly higher weight in algorithm distribution than standard double-tap Likes."
  },
  {
    question: "How do I find my Instagram Reach metrics?",
    answer: "You can find your Reach metric in Instagram Insights on any Professional or Creator account. Open a post or Reel, tap 'View Insights', and locate the 'Accounts Reached' metric under the Overview section."
  },
  {
    question: "Is this calculator free and private?",
    answer: "Yes, 100% free and client-side. Your inputs are calculated instantly in your browser without sending any data to external servers or storing personal profile information."
  }
];

const title = "Instagram Engagement Rate Calculator (ERR & ERF) | Get Micro Tools";
const description = "Calculate your Instagram Engagement Rate by Reach (ERR) and Followers (ERF). Free, instant creator-tier benchmarks, formula breakdowns, and actionable insights.";
const keywords = "instagram engagement rate calculator, ERR calculator, ERF calculator, instagram reach engagement rate, instagram creator benchmarks, instagram analytics tool, calculate instagram engagement";
const url = "https://getmicro.tools/instagram-engagement-rate-calculator";

const creatorTiers = [
  { name: 'Nano Creator', range: '< 10k', avgERR: '4.0% - 7.0%', avgERF: '2.0% - 5.0%', target: '6.0%+', tip: 'High engagement density; focus on building tight community trust.' },
  { name: 'Micro Creator', range: '10k - 50k', avgERR: '2.5% - 4.5%', avgERF: '1.5% - 3.0%', target: '4.0%+', tip: 'Ideal tier for brand sponsorships; optimize shareable carousels.' },
  { name: 'Mid-Tier Creator', range: '50k - 200k', avgERR: '1.8% - 3.2%', avgERF: '1.0% - 2.0%', target: '2.8%+', tip: 'Reach broadens; focus on high-retention Reels & strong hooks.' },
  { name: 'Macro Creator', range: '200k - 1M', avgERR: '1.2% - 2.2%', avgERF: '0.6% - 1.2%', target: '1.8%+', tip: 'High reach volume; use Story stickers to maintain follower loyalty.' },
  { name: 'Mega Creator', range: '1M+', avgERR: '0.8% - 1.5%', avgERF: '0.4% - 0.9%', target: '1.2%+', tip: 'Massive scale; algorithm prioritizes viral share loops and trends.' }
];
---

<Layout 
  title={title}
  description={description} 
  keywords={keywords}
  url={url}
>
  <Nav />

  <main class="min-h-screen bg-canvas">
    {/* Header Section */}
    <header class="max-w-4xl mx-auto px-6 pt-16 pb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-pill bg-surface-strong text-ink text-[11px] font-semibold uppercase tracking-wider mb-6 border border-hairline shadow-xs">
        <span class="text-xs">📸</span> Instagram Analytics Tool
      </div>
      <h1 class="text-display-lg md:text-display-mega text-ink mb-4 font-bold tracking-tight">
        Instagram Engagement Rate Calculator
      </h1>
      <p class="text-body text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
        Audit post performance using <strong>Reach-Based (ERR)</strong> and <strong>Follower-Based (ERF)</strong> metrics, backed by creator tier benchmarks and algorithm intent analysis.
      </p>
    </header>

    {/* Calculator & Analysis Card Section */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="bg-surface-card rounded-2xl border border-hairline overflow-hidden shadow-sm">
        
        {/* Calculation Mode Toggle Header */}
        <div class="p-5 sm:p-6 border-b border-hairline bg-canvas-soft flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold uppercase tracking-wider text-primary">01. Methodology</span>
            </div>
            <h2 class="text-base font-semibold text-ink">Calculation Model</h2>
            <p class="text-xs text-muted">Select your primary analysis metric</p>
          </div>
          <div 
            class="flex flex-wrap gap-2.5" 
            id="calc-mode-group" 
            role="radiogroup" 
            aria-label="Calculation Mode Selector"
          >
            <button 
              type="button" 
              data-mode="err" 
              class="calc-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-primary bg-primary/10 text-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2 shadow-xs"
              aria-checked="true"
              role="radio"
              tabindex="0"
            >
              <span>🎯 Reach-Based (ERR)</span>
              <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-primary/20 font-bold uppercase tracking-wider">Reels & Reach</span>
            </button>
            <button 
              type="button" 
              data-mode="erf" 
              class="calc-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-hairline bg-surface-card text-muted hover:text-ink hover:border-hairline-strong transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2"
              aria-checked="false"
              role="radio"
              tabindex="-1"
            >
              <span>👥 Follower-Based (ERF)</span>
              <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-canvas-soft text-muted font-medium border border-hairline">Profile Audit</span>
            </button>
          </div>
        </div>

        {/* Main Grid: Inputs vs Results */}
        <div class="p-4 sm:p-6 md:p-8 xl:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
          
          {/* Inputs Column */}
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center justify-between border-b border-hairline-soft pb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-primary">02. Data Input</span>
                <h3 class="text-sm font-semibold text-ink uppercase tracking-wider">Post Metrics</h3>
              </div>
              <div class="flex items-center gap-2 sm:gap-3">
                <button 
                  type="button" 
                  id="reset-calc-btn" 
                  class="px-2.5 py-1 text-xs font-semibold text-muted hover:text-ink hover:bg-surface-strong rounded-md border border-hairline transition-all flex items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs cursor-pointer"
                  title="Reset all fields to default"
                >
                  <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Reset Calculator</span>
                </button>
                <span class="text-[11px] text-muted font-medium hidden sm:flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span> Live Calculation
                </span>
              </div>
            </div>

            {/* Group 1: Audience & Reach Base Panel */}
            <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
                  <span class="text-sm">🌐</span> Audience Base
                </span>
                <span class="text-[10px] text-muted font-normal">Denominators for rate formulas</span>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label for="ig-followers" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Total Followers</span>
                    <span class="text-[10px] text-muted font-normal">Profile Base</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-followers" 
                    min="0" 
                    step="1"
                    placeholder="e.g. 25000" 
                    aria-describedby="followers-hint followers-error"
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm aria-invalid:border-red-500 shadow-2xs" 
                  />
                  <p id="followers-hint" class="text-[11px] text-muted leading-tight">Used for ERF & Creator Tier detection</p>
                  <p id="followers-error" class="text-[11px] text-red-500 font-medium hidden flex items-center gap-1">
                    <span>⚠️</span> <span id="followers-error-text">Please enter a non-negative whole number.</span>
                  </p>
                </div>

                <div class="space-y-2">
                  <label for="ig-reach" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Accounts Reached</span>
                    <span class="text-[10px] text-muted font-normal">Insights</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-reach" 
                    min="0" 
                    step="1"
                    placeholder="e.g. 18500" 
                    aria-describedby="reach-hint reach-error"
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm aria-invalid:border-red-500 shadow-2xs" 
                  />
                  <p id="reach-hint" class="text-[11px] text-muted leading-tight">Used for ERR (True Post Impact)</p>
                  <p id="reach-error" class="text-[11px] text-red-500 font-medium hidden flex items-center gap-1">
                    <span>⚠️</span> <span id="reach-error-text">Please enter a non-negative whole number.</span>
                  </p>
                </div>
              </div>
            </div>

            {/* Group 2: Interactions Panel */}
            <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
                  <span class="text-sm">📊</span> Post Interactions
                </span>
                <span class="text-[10px] text-muted font-normal">Numerators for rate formulas</span>
              </div>
              
              <div class="grid grid-cols-2 sm:grid-cols-2 gap-3.5">
                <div class="space-y-1.5">
                  <label for="ig-likes" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Likes</span>
                    <span>❤️</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-likes" 
                    min="0" 
                    step="1"
                    placeholder="0" 
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3 py-2 text-ink text-sm font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all aria-invalid:border-red-500 shadow-2xs" 
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="ig-comments" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Comments</span>
                    <span>💬</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-comments" 
                    min="0" 
                    step="1"
                    placeholder="0" 
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3 py-2 text-ink text-sm font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all aria-invalid:border-red-500 shadow-2xs" 
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="ig-shares" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Shares / Sends</span>
                    <span>🚀</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-shares" 
                    min="0" 
                    step="1"
                    placeholder="0" 
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3 py-2 text-ink text-sm font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all aria-invalid:border-red-500 shadow-2xs" 
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="ig-saves" class="text-xs font-semibold text-ink flex items-center justify-between">
                    <span>Saves</span>
                    <span>🔖</span>
                  </label>
                  <input 
                    type="number" 
                    id="ig-saves" 
                    min="0" 
                    step="1"
                    placeholder="0" 
                    class="w-full bg-surface-card border border-hairline rounded-lg px-3 py-2 text-ink text-sm font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all aria-invalid:border-red-500 shadow-2xs" 
                  />
                </div>
              </div>

              <p id="interactions-error" class="text-[11px] text-red-500 font-medium hidden flex items-center gap-1 pt-1">
                <span>⚠️</span> <span id="interactions-error-text">Interaction counts cannot be negative.</span>
              </p>

              {/* Auto-calculated Read-only Total Engagements */}
              <div class="mt-4 pt-3.5 border-t border-hairline-soft space-y-2">
                <div class="flex items-center justify-between">
                  <label for="ig-total-engagements" class="text-xs font-semibold text-ink flex items-center gap-1.5">
                    <span>Total Engagements</span>
                    <span>⚡</span>
                  </label>
                  <span class="text-[10px] font-semibold text-muted bg-surface-strong px-2 py-0.5 rounded-md border border-hairline">Auto-Calculated</span>
                </div>
                <input 
                  type="number" 
                  id="ig-total-engagements" 
                  readonly
                  tabindex="-1"
                  placeholder="0" 
                  aria-describedby="total-engagements-hint"
                  class="w-full bg-canvas-soft/80 border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-bold text-base focus:outline-none cursor-not-allowed select-none shadow-2xs opacity-90" 
                />
                <p id="total-engagements-hint" class="text-[11px] text-muted leading-tight">Automatically calculated sum of Likes, Comments, Shares, and Saves.</p>
              </div>
            </div>

            {/* Dynamic Non-blocking Input Warnings Banner */}
            <div id="input-warning-banner" class="hidden p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-700 dark:text-amber-300 space-y-1 transition-all">
            </div>

            {/* Guidance Callout Box */}
            <div class="p-3.5 rounded-xl bg-canvas-soft border border-hairline-soft text-xs text-muted leading-relaxed flex items-start gap-2.5">
              <span class="text-base leading-none pt-0.5">💡</span>
              <div>
                <strong>Analytical Distinction:</strong> <strong>ERR</strong> measures audience conversion efficiency among active post viewers. <strong>ERF</strong> evaluates broader brand authority across total follower count.
              </div>
            </div>
          </div>

          {/* Results Analysis Console Column */}
          <div 
            class="lg:col-span-5 flex flex-col justify-between p-5 sm:p-6 bg-canvas-soft rounded-2xl border border-hairline space-y-6"
            role="region"
            aria-label="Engagement Calculation Results"
            aria-live="polite"
          >
            <div class="space-y-6">
              
              {/* Dashboard Header */}
              <div class="flex items-center justify-between border-b border-hairline-soft pb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-primary">03. Analysis</span>
                  <h3 class="text-xs sm:text-sm font-semibold text-ink uppercase tracking-wider">Results Console</h3>
                </div>
                <span id="tier-badge" class="px-2.5 py-1 rounded-pill bg-surface-strong text-ink text-xs font-semibold border border-hairline shadow-2xs">
                  Nano Creator (&lt; 10k)
                </span>
              </div>

              {/* HERO PRIMARY METRIC FOCUS BLOCK */}
              <div class="p-6 bg-surface-card rounded-xl border border-hairline shadow-sm text-center relative space-y-3">
                <span id="primary-metric-label" class="text-[11px] font-bold uppercase tracking-wider text-muted block">
                  Engagement Rate by Reach (ERR)
                </span>
                
                <div class="flex items-baseline justify-center gap-1 my-1">
                  <span id="primary-metric-value" class="text-display-mega text-ink font-bold tracking-tight">0.00</span>
                  <span class="text-display-md text-muted font-semibold">%</span>
                </div>

                {/* Benchmark Rating Pill */}
                <div 
                  id="benchmark-badge" 
                  class="flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-pill bg-surface-strong text-muted font-semibold text-xs uppercase tracking-wider border border-hairline transition-all mx-auto max-w-max shadow-2xs"
                >
                  Awaiting Data
                </div>

                {/* Active Formula Badge */}
                <div id="active-formula-display" class="mt-2 inline-block px-3 py-1 bg-canvas-soft rounded-md font-mono text-[11px] text-muted border border-hairline-soft">
                  Formula: ERR = (Engagements / Reach) × 100
                </div>

                {/* Rating Explanation Note */}
                <p id="benchmark-explanation" class="text-xs text-muted leading-relaxed text-center pt-1 px-1">
                  Enter post reach & interactions to compute ERR and evaluate against your tier standard.
                </p>
              </div>

              {/* GROUPED SUPPORTING METRICS */}
              <div class="space-y-4 pt-1">
                <span class="text-xs font-bold text-ink uppercase tracking-wider block border-b border-hairline-soft pb-2">
                  Supporting Metrics & Ratios
                </span>

                {/* Group 1: Supporting Rate & Volume */}
                <div class="grid grid-cols-2 gap-3">
                  <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
                    <span id="secondary-metric-label" class="text-[11px] font-semibold text-muted block truncate">
                      ER by Followers (ERF)
                    </span>
                    <span id="secondary-metric-value" class="text-base font-bold text-ink block">
                      0.00%
                    </span>
                  </div>

                  <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
                    <span class="text-[11px] font-semibold text-muted block truncate">
                      Total Engagements
                    </span>
                    <span id="total-engagements" class="text-base font-bold text-ink block">
                      0
                    </span>
                  </div>
                </div>

                {/* Group 2: Algorithm Intent Ratios */}
                <div class="p-3.5 bg-surface-card rounded-lg border border-hairline-soft space-y-2.5">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">
                    Algorithm Intent Signals
                  </span>
                  
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-muted flex items-center gap-1">
                      <span>🔖</span> Save-to-Like Ratio
                    </span>
                    <span id="save-like-ratio" class="text-ink font-semibold bg-canvas-soft px-2 py-0.5 rounded border border-hairline-soft">
                      0.0%
                    </span>
                  </div>

                  <div class="flex justify-between items-center text-xs">
                    <span class="text-muted flex items-center gap-1">
                      <span>🚀</span> Share-to-Like Ratio
                    </span>
                    <span id="share-like-ratio" class="text-ink font-semibold bg-canvas-soft px-2 py-0.5 rounded border border-hairline-soft">
                      0.0%
                    </span>
                  </div>
                </div>
              </div>

              {/* ACTIONABLE DETERMINISTIC INSIGHTS & RECOMMENDATIONS */}
              <div class="pt-2 space-y-3">
                <span id="insights-heading" class="text-xs font-bold uppercase tracking-wider text-ink block">
                  Actionable Performance Insights
                </span>
                
                <div id="recommendations-list" class="space-y-2.5">
                  <div class="p-3.5 rounded-lg bg-surface-card border border-hairline text-xs text-muted leading-relaxed">
                    Select a calculation mode and input post metrics above to generate rule-based performance recommendations.
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Detailed Educational & Methodological Content Section */}
    <section class="max-w-4xl mx-auto px-6 py-16 border-t border-hairline">
      <div class="prose prose-sm md:prose-base prose-ink max-w-none space-y-16">
        
        {/* Section 1: What is Instagram Engagement Rate? */}
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">01 / Fundamentals</span>
          </div>
          <h2 class="text-display-sm text-ink font-bold">What is Instagram Engagement Rate?</h2>
          <p class="text-body leading-relaxed">
            <strong>Instagram Engagement Rate</strong> is the quantitative metric that measures how actively your audience interacts with your content relative to your account size or post reach. Rather than relying on total followers—which can be inflated by dormant accounts or past algorithm trends—engagement rate reveals the <em>true depth of audience connection and content quality</em>.
          </p>
          <p class="text-body leading-relaxed">
            When you publish a post, Reel, or Carousel, Instagram tracks user interactions across four primary intent signals:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 bg-surface-card rounded-xl border border-hairline space-y-1.5 shadow-2xs">
              <div class="flex items-center gap-2">
                <span class="text-lg">❤️</span>
                <h3 class="text-sm font-semibold text-ink">Likes (Baseline Appeal)</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">Low-friction double-taps that confirm visual appeal. Likes form baseline engagement, though they carry lower weight in modern recommendation algorithms.</p>
            </div>
            <div class="p-4 bg-surface-card rounded-xl border border-hairline space-y-1.5 shadow-2xs">
              <div class="flex items-center gap-2">
                <span class="text-lg">💬</span>
                <h3 class="text-sm font-semibold text-ink">Comments (Dwell & Community)</h3>
              </div>
              <p class="text-xs text-muted leading-relaxed">High-intent written responses that signal active conversation. Comments extend post dwell time and alert the algorithm to strong audience interest.</p>
            </div>
            <div class="p-4 bg-surface-card rounded-xl border border-hairline space-y-1.5 shadow-2xs">
              <div class="flex items-center gap-2">
                <span class="text-lg">🚀</span>
                <h3 class="text-sm font-semibold text-ink">Shares / Sends (Viral Multiplier)</h3>
              </div>
