---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import UploadZone from '../components/instagram-preview/UploadZone.astro';
import OverlayControls from '../components/instagram-preview/OverlayControls.astro';
import SafeZoneGuide from '../components/instagram-preview/SafeZoneGuide.astro';
import ReelsMockup from '../components/instagram-preview/ReelsMockup.astro';
import FormatSelector from '../components/instagram-preview/FormatSelector.astro';

import FAQ from '../components/FAQ.astro';

const title = "Instagram Reels Safe Zone Checker & Overlay Tester (1080x1920) | Get Micro Tools";
const description = "Free client-side Instagram Reels safe zone tester. Check your vertical 9:16 videos against native UI icons, captions, and 4:5 feed crops before posting.";
const keywords = "instagram reels safe zone, reels overlay tester, instagram reel safe zone checker, reels safe zone dimensions, 9:16 video safe zone, instagram ui overlay tester";
const url = "https://getmicrotools.com/instagram-reels-overlay-tester";

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Instagram Reels Safe Zone Checker & Overlay Tester",
  "alternateName": [
    "Reels Overlay Tester",
    "Instagram Video Safe Zone Checker",
    "9:16 Safe Zone Preview Tool"
  ],
  "url": "https://getmicrotools.com/instagram-reels-overlay-tester",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": "Free client-side preview tool to verify 9:16 vertical videos against native Instagram Reels UI layers, action buttons, captions, and 4:5 home feed crops.",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Get Micro Tools",
    "url": "https://getmicrotools.com"
  },
  "featureList": [
    "Instant client-side MP4 video and image preview with zero server uploads",
    "9:16 Full Screen Reels and 4:5 Portrait Home Feed format toggles",
    "Independently toggleable UI layers: Header, Right Action Bar, Profile Info, Caption, and Bottom Navigation",
    "Original Fit (letterbox) vs Fill Screen (cover) scaling modes",
    "Live aspect ratio detection for uploaded media assets"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getmicrotools.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Instagram Reels Overlay Tester",
      "item": "https://getmicrotools.com/instagram-reels-overlay-tester"
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Check and Protect Safe Zones on Instagram Reels",
  "description": "A step-by-step workflow for testing vertical video text placement against Instagram UI layers.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Step 1: Export Video at 1080x1920 Resolution",
      "text": "Export your 9:16 vertical video from your editing software at 1080x1920 resolution in MP4 or MOV format."
    },
    {
      "@type": "HowToStep",
      "name": "Step 2: Upload Media to the Safe Zone Tester",
      "text": "Drag and drop your video file into the browser preview tool. Processing executes 100% locally on your device."
    },
    {
      "@type": "HowToStep",
      "name": "Step 3: Audit UI Occlusion and Dead Zones",
      "text": "Check that on-screen titles, subtitles, and key visual focal points are clear of the top header (220px), bottom caption area (440px), and right action icons (120px)."
    },
    {
      "@type": "HowToStep",
      "name": "Step 4: Check 4:5 Portrait Feed Crop",
      "text": "Switch the format selector to 4:5 Portrait Feed to ensure your primary hook remains centered when non-followers see your Reel in their main feed."
    }
  ]
};

const faqs = [
  {
    question: "What are the exact safe zone pixel dimensions for Instagram Reels (1080x1920)?",
    answer: "For a standard 1080×1920 vertical video, leave a 220px margin at the top (under username/search), a 440px margin at the bottom (above captions, audio attribution, and bottom navigation), and a 120px margin on the right edge (clear of Like, Comment, Share, and Remix buttons). The central safe zone is approximately 1000px wide by 1260px high."
  },
  {
    question: "Why does Instagram crop 9:16 Reels to 4:5 on the Home Feed?",
    answer: "When a user scrolls through their standard Instagram Home Feed, Reels are rendered in a 4:5 aspect ratio (1080×1350) rather than full 9:16. Instagram crops 285 pixels off the top and 285 pixels off the bottom. If your headline or hook is placed too high or low, it will be invisible in the main feed until the user taps to open the full-screen player."
  },
  {
    question: "How does the 1:1 Profile Grid crop affect Reels?",
    answer: "On your public profile grid, Reels are displayed as a square 1:1 thumbnail (1080×1080). This crops 420 pixels off both the top and bottom of your 9:16 video. Keep your primary subject and thumbnail text strictly inside the central 1080×1080 square."
  },
  {
    question: "Are my uploaded videos or images sent to any server?",
    answer: "No. The Get Micro Tools Reels Overlay Tester processes all media entirely client-side inside your web browser using HTML5 Canvas and video APIs. Your media never leaves your device."
  },
  {
    question: "Can I use this tool to test TikTok and YouTube Shorts videos?",
    answer: "Yes. While TikTok and YouTube Shorts have slightly different action bar layouts, the core 9:16 vertical canvas (1080×1920) and bottom caption exclusion zones (350–450px) are very similar. Content that passes our Instagram safe zone checks will generally be safe on TikTok and Shorts as well."
  }
];
---

<Layout title={title} description={description} keywords={keywords} url={url}>
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  {/* Force dark mode for this page specifically by wrapping the content */}
  <div class="dark bg-canvas min-h-screen w-full flex flex-col">
    <Nav />

    <main class="flex-grow text-ink font-sans">
      <div class="max-w-7xl mx-auto px-6 py-12 md:py-24">
      {/* Header */}
      <header class="mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-pill bg-surface-strong text-ink text-[11px] font-semibold uppercase tracking-wider mb-6">
          Visual Testing
        </div>
        <h1 class="text-display-lg md:text-display-mega mb-6 tracking-tight text-ink">Reels Overlay Tester</h1>
        <p class="text-body text-lg max-w-2xl leading-relaxed">
          Upload your media to see exactly how it will look inside the native Instagram player. 
          Identify dead zones where buttons, captions, and feed crops block your hooks.
        </p>
      </header>

      {/* Main Layout Grid */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        
        {/* Left Side: Upload Zone */}
        <div class="space-y-8">
          <UploadZone />
          <FormatSelector />
          <div id="reels-controls-group" class="space-y-8 transition-all duration-200">
            <OverlayControls />
            <SafeZoneGuide />
          </div>
        </div>

        {/* Right Side: Smartphone Mockup */}
        <ReelsMockup />
      </div>

      {/* Technical Safe-Zone Guide Section */}
      <section class="mt-24 pt-24 border-t border-hairline max-w-5xl mx-auto space-y-16">
        
        {/* Section 1: Pixel Safe-Zone Specification */}
        <div class="space-y-6">
          <div class="border-b border-hairline pb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Technical Specifications</span>
            <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">1080×1920 Reels Safe Zone Coordinate Blueprint</h2>
            <p class="text-sm text-muted mt-1">Exact exclusion margins based on Instagram's native mobile UI overlays for standard 9:16 vertical video exports.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 not-prose">
            <div class="p-5 rounded-2xl bg-surface-card border border-hairline space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wider">Top Exclusion Zone</span>
                <span class="text-[10px] font-mono font-bold text-red-400 bg-red-500/10 px-2 py-0.5 rounded">0 – 220px</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                Covers audio search, top camera controls, and native phone notch/Dynamic Island cutouts. Avoid headlines here.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-surface-card border border-hairline space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wider">Bottom Exclusion Zone</span>
                <span class="text-[10px] font-mono font-bold text-red-400 bg-red-500/10 px-2 py-0.5 rounded">1480 – 1920px</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                Covers account handle, follow button, multi-line caption, audio attribution pill, and bottom app navigation bar.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-surface-card border border-hairline space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wider">Right Action Margin</span>
                <span class="text-[10px] font-mono font-bold text-red-400 bg-red-500/10 px-2 py-0.5 rounded">960 – 1080px</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                Covers Like, Comment, Share/Send, Bookmark, and Remix vertical icon stack. Keep text and faces clear of the right 120px.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-surface-card border border-hairline space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Active Text Canvas</span>
                <span class="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">1000 × 1260px</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                The guaranteed visible area across all mobile screen aspect ratios. Center your primary hook and subtitles here.
              </p>
            </div>
          </div>
        </div>

        {/* Section 2: Feed Crop Physics (9:16 vs 4:5 vs 1:1) */}
        <div class="space-y-6">
          <div class="border-b border-hairline pb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Aspect Ratio Physics</span>
            <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">How Instagram Crops Reels Across App Surfaces</h2>
            <p class="text-sm text-muted mt-1">Understanding how a single 9:16 video asset is rendered across the Reels Tab, Home Feed, and Profile Grid.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 not-prose">
            <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-ink">1. Reels Tab (Full 9:16)</h3>
                <span class="text-xs font-mono text-primary font-bold">1080 × 1920</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                Full-bleed vertical display. All native UI overlay icons sit directly on top of your video frame. Full safe-zone clearance required.
              </p>
              <div class="p-3 bg-canvas-soft rounded-lg text-xs font-mono text-muted border border-hairline">
                Visible Area: 100% of height
              </div>
            </div>

            <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-ink">2. Home Feed (4:5 Crop)</h3>
                <span class="text-xs font-mono text-primary font-bold">1080 × 1350</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                When Reels appear in follower and recommended home feeds, Instagram automatically crops <strong>285px off the top</strong> and <strong>285px off the bottom</strong>.
              </p>
              <div class="p-3 bg-canvas-soft rounded-lg text-xs font-mono text-muted border border-hairline">
                Crop: Top & Bottom 14.8% removed
              </div>
            </div>

            <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-bold text-ink">3. Profile Grid (1:1 Square)</h3>
                <span class="text-xs font-mono text-primary font-bold">1080 × 1080</span>
              </div>
              <p class="text-xs text-muted leading-relaxed">
                The profile grid displays a center square crop, removing <strong>420px off top and bottom</strong>. Thumbnail titles must be positioned in the exact vertical center.
              </p>
              <div class="p-3 bg-canvas-soft rounded-lg text-xs font-mono text-muted border border-hairline">
                Crop: Top & Bottom 21.8% removed
              </div>
            </div>
          </div>
        </div>

        {/* Section 3: Subtitle & Captions Placement Best Practices */}
        <div class="p-8 rounded-2xl bg-surface-card border border-hairline space-y-6 not-prose">
          <div class="flex items-center gap-2 text-primary font-bold text-xs uppercase tracking-wider">
            <span>🎬</span> Video Editing Best Practices
          </div>
          <h2 class="text-2xl font-bold text-ink tracking-tight">4 Rules for Safe Subtitle & Text Placement</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-2">
              <h3 class="text-sm font-bold text-ink">1. Position Subtitles at Y: 1150–1350px</h3>
              <p class="text-xs text-muted leading-relaxed">
                Place auto-captions and animated subtitles just above the bottom caption buffer. This keeps them readable in both 9:16 and 4:5 modes without overlapping username tags.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-2">
              <h3 class="text-sm font-bold text-ink">2. Limit Dynamic Text to 2–4 Words Per Line</h3>
              <p class="text-xs text-muted leading-relaxed">
                Long lines of text will spread into the right 120px icon dead zone. Keep kinetic captions compact and centered to ensure complete visibility.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-2">
              <h3 class="text-sm font-bold text-ink">3. Add Contrast Shadow or Dark Box</h3>
              <p class="text-xs text-muted leading-relaxed">
                White text with a 30–50% black stroke or soft drop shadow prevents your hooks from disappearing when footage passes through high-brightness scenes.
              </p>
            </div>

            <div class="p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-2">
              <h3 class="text-sm font-bold text-ink">4. Check Device Aspect Ratio Variances</h3>
              <p class="text-xs text-muted leading-relaxed">
                Taller phones (19.5:9 or 20:9 aspect ratios like iPhone 15/16 and Samsung Galaxy S24) expand letterboxing differently than standard 16:9 displays.
              </p>
            </div>
          </div>
        </div>

        {/* Section 4: Related Tools */}
        <div class="space-y-6">
          <div class="border-b border-hairline pb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Creator Toolkit</span>
            <h2 class="text-2xl font-bold text-ink tracking-tight mt-1">Related Social Media Utilities</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
            <a href="/instagram-engagement-rate-calculator" class="p-5 bg-surface-card hover:bg-surface-strong rounded-xl border border-hairline transition-all group flex flex-col justify-between space-y-2">
              <div>
                <h3 class="text-sm font-bold text-ink group-hover:text-primary transition-colors">📈 Instagram Engagement Rate Calculator</h3>
                <p class="text-xs text-muted mt-1 leading-relaxed">Calculate your Reach (ERR) and Follower (ERF) engagement rates with 2026 creator tier benchmarks.</p>
              </div>
              <span class="text-xs font-semibold text-primary inline-flex items-center gap-1">Calculate Engagement &rarr;</span>
            </a>

            <a href="/tiktok-bio-checker" class="p-5 bg-surface-card hover:bg-surface-strong rounded-xl border border-hairline transition-all group flex flex-col justify-between space-y-2">
              <div>
                <h3 class="text-sm font-bold text-ink group-hover:text-primary transition-colors">🎵 TikTok Bio Checker & Counter</h3>
                <p class="text-xs text-muted mt-1 leading-relaxed">Test your profile bio against the official 80-character limit with authentic mobile previews.</p>
              </div>
              <span class="text-xs font-semibold text-primary inline-flex items-center gap-1">Check TikTok Bio &rarr;</span>
            </a>
          </div>
        </div>

        {/* Section 5: FAQ Component */}
        <FAQ faqs={faqs} title="Instagram Reels Safe Zone FAQ" description="Common questions about Instagram Reels safe zones, 4:5 feed crops, video export resolution, and device UI overlays." />

      </section>
    </div>
  </main>

  <Footer />

  <script>
    import { isVideoFile, getMediaConfig, getAspectRatioLabel } from '../utils/instagram-preview/media-helpers.js';

    const fileUpload = document.getElementById('file-upload');
    const mediaViewport = document.getElementById('media-viewport');
    const dropZone = document.getElementById('drop-zone');
    const toggleFitOriginal = document.getElementById('toggle-fit-original');
    const toggleFitFill = document.getElementById('toggle-fit-fill');
    const aspectBadge = document.getElementById('detected-aspect-ratio');
    const clearMediaBtn = document.getElementById('clear-media-btn');

    // Format selection variables
    const formatReelsBtn = document.getElementById('format-reels');
    const formatPortraitBtn = document.getElementById('format-portrait');
    const mockupContainer = document.getElementById('mockup-container');
    const reelsControlsGroup = document.getElementById('reels-controls-group');
    const portraitViewsOverlay = document.getElementById('portrait-views-overlay');
    const fitModeSelectorContainer = document.getElementById('fit-mode-selector-container');

    let currentFitMode = 'original'; // 'original' by default
    let currentFormat = 'reels'; // 'reels' by default

    const updateFormat = (format) => {
      currentFormat = format;
      
      if (!mockupContainer) return;

      // Update button styling
      if (formatReelsBtn && formatPortraitBtn) {
        if (format === 'reels') {
          formatReelsBtn.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer bg-[#f54e00] text-ink shadow-xs border border-hairline/10 font-bold";
          formatPortraitBtn.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer text-muted hover:text-ink bg-transparent font-medium";
        } else {
          formatReelsBtn.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer text-muted hover:text-ink bg-transparent font-medium";
          formatPortraitBtn.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer bg-[#f54e00] text-ink shadow-xs border border-hairline/10 font-bold";
        }
      }

      // Update mockup container class for aspect ratio and hiding Reels overlays
      if (format === 'reels') {
        mockupContainer.classList.remove('aspect-[4/5]', 'format-portrait');
        mockupContainer.classList.add('aspect-[9/19]', 'format-reels');
        if (reelsControlsGroup) {
          reelsControlsGroup.classList.remove('hidden');
        }
        if (portraitViewsOverlay) {
          portraitViewsOverlay.classList.add('hidden');
          portraitViewsOverlay.classList.remove('flex');
        }
        if (fitModeSelectorContainer) {
          fitModeSelectorContainer.classList.remove('hidden');
        }

        // Restore Reels fit mode selection
        const mediaElement = mediaViewport ? mediaViewport.querySelector('img, video') : null;
        if (mediaElement) {
          if (currentFitMode === 'original') {
            mediaElement.classList.remove('object-cover');
            mediaElement.classList.add('object-contain');
          } else {
            mediaElement.classList.remove('object-contain');
            mediaElement.classList.add('object-cover');
          }
        }
      } else if (format === 'portrait') {
        mockupContainer.classList.remove('aspect-[9/19]', 'format-reels');
        mockupContainer.classList.add('aspect-[4/5]', 'format-portrait');
        if (reelsControlsGroup) {
          reelsControlsGroup.classList.add('hidden');
        }
        if (portraitViewsOverlay) {
          portraitViewsOverlay.classList.remove('hidden');
          portraitViewsOverlay.classList.add('flex');
        }
        if (fitModeSelectorContainer) {
          fitModeSelectorContainer.classList.add('hidden');
        }

        // Force Zoomed/Fill screen (object-cover) for Portrait Feed
        const mediaElement = mediaViewport ? mediaViewport.querySelector('img, video') : null;
        if (mediaElement) {
          mediaElement.classList.remove('object-contain');
          mediaElement.classList.add('object-cover');
        }
      }
    };

    if (formatReelsBtn && formatPortraitBtn) {
      formatReelsBtn.addEventListener('click', () => updateFormat('reels'));
      formatPortraitBtn.addEventListener('click', () => updateFormat('portrait'));
    }

    const updateFitMode = (mode) => {
      currentFitMode = mode;
      
      // Update toggle buttons styling
      if (toggleFitOriginal && toggleFitFill) {
        if (mode === 'original') {
          toggleFitOriginal.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer bg-canvas-soft text-ink shadow-xs border border-hairline/10";
          toggleFitFill.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer text-muted hover:text-ink bg-transparent";
        } else {
          toggleFitOriginal.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer text-muted hover:text-ink bg-transparent";
          toggleFitFill.className = "py-2 px-1 text-center rounded-lg transition-all duration-150 cursor-pointer bg-canvas-soft text-ink shadow-xs border border-hairline/10";
        }
      }

      // Update active media if loaded (only when in reels format)
      if (mediaViewport && currentFormat === 'reels') {
        const mediaElement = mediaViewport.querySelector('img, video');
        if (mediaElement) {
          if (mode === 'original') {
            mediaElement.classList.remove('object-cover');
            mediaElement.classList.add('object-contain');
          } else {
            mediaElement.classList.remove('object-contain');
            mediaElement.classList.add('object-cover');
          }
        }
      }
    };

    if (toggleFitOriginal && toggleFitFill) {
      toggleFitOriginal.addEventListener('click', () => updateFitMode('original'));
      toggleFitFill.addEventListener('click', () => updateFitMode('fill'));
    }

    const handleMedia = (file) => {
      if (!file) return;

      const reader = new FileReader();
      const isVideo = isVideoFile(file);

      reader.onload = (e) => {
        const source = e.target.result;
        mediaViewport.innerHTML = ''; // Clear preview

        // Portrait format is locked to 'fill', otherwise use currentFitMode
        const activeFit = currentFormat === 'portrait' ? 'fill' : currentFitMode;
        const config = getMediaConfig(isVideo, activeFit);
        const element = document.createElement(config.tagName);
        element.className = config.className;
        
        // Set other attributes
        Object.entries(config.attributes).forEach(([key, value]) => {
          element[key] = value;
        });

        // Set aspect ratio detection
        if (isVideo) {
          element.addEventListener('loadedmetadata', () => {
            const width = element.videoWidth;
            const height = element.videoHeight;
            const label = getAspectRatioLabel(width, height);
            if (aspectBadge) {
              aspectBadge.textContent = label;
              aspectBadge.classList.remove('hidden');
            }
          });
        } else {
          element.addEventListener('load', () => {
            const width = element.naturalWidth;
            const height = element.naturalHeight;
            const label = getAspectRatioLabel(width, height);
            if (aspectBadge) {
              aspectBadge.textContent = label;
              aspectBadge.classList.remove('hidden');
            }
          });
        }

        element.src = source;
        mediaViewport.appendChild(element);

        // Show the Clear/Remove button
        if (clearMediaBtn) {
          clearMediaBtn.classList.remove('hidden');
          clearMediaBtn.classList.add('flex');
        }
      };

      reader.readAsDataURL(file);
    };

    if (fileUpload && mediaViewport && dropZone) {
      fileUpload.addEventListener('change', (e) => {
        handleMedia(e.target.files[0]);
      });

      if (clearMediaBtn) {
        clearMediaBtn.addEventListener('click', () => {
          if (fileUpload) {
            fileUpload.value = '';
          }
          if (mediaViewport) {
            mediaViewport.innerHTML = `
              <div class="text-zinc-600 flex flex-col items-center gap-4 text-center px-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 opacity-40 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <p class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-40 text-white">Preview Area</p>
              </div>
            `;
          }
          if (aspectBadge) {
            aspectBadge.textContent = '';
            aspectBadge.classList.add('hidden');
          }
          clearMediaBtn.classList.add('hidden');
          clearMediaBtn.classList.remove('flex');
        });
      }

      // Drag and Drop Logic
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
        }, false);
      });

      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => {
          dropZone.classList.add('border-primary', 'bg-canvas-soft');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => {
          dropZone.classList.remove('border-primary', 'bg-canvas-soft');
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const file = dt.files[0];
        handleMedia(file);
      }, false);
    }

    // UI Overlay Toggles Logic
    const registerToggle = (toggleId, overlayId, containerClass = '') => {
      const toggleEl = document.getElementById(toggleId);
      const overlayEl = document.getElementById(overlayId);
      const mockupContainer = document.getElementById('mockup-container');

      if (toggleEl && overlayEl) {
        // Set initial state matching checkbox status
        const isChecked = toggleEl.checked;
        if (isChecked) {
          overlayEl.classList.remove('hidden');
          if (containerClass && mockupContainer) {
            mockupContainer.classList.add(containerClass);
          }
        } else {
          overlayEl.classList.add('hidden');
          if (containerClass && mockupContainer) {
            mockupContainer.classList.remove(containerClass);
          }
        }

        toggleEl.addEventListener('change', (e) => {
          const checked = e.target.checked;
          if (checked) {
            overlayEl.classList.remove('hidden');
            if (containerClass && mockupContainer) {
              mockupContainer.classList.add(containerClass);
            }
          } else {
            overlayEl.classList.add('hidden');
            if (containerClass && mockupContainer) {
              mockupContainer.classList.remove(containerClass);
            }
          }
        });
      }
    };

    // Register all 6 overlays
    registerToggle('toggle-top-header', 'overlay-top-header');
    registerToggle('toggle-right-action', 'overlay-right-action');
    registerToggle('toggle-profile', 'overlay-profile');
    registerToggle('toggle-caption', 'overlay-caption');
    registerToggle('toggle-bottom-cta', 'overlay-bottom-cta', 'show-bottom-cta');
    registerToggle('toggle-bottom-nav', 'overlay-bottom-nav', 'show-bottom-nav');
  </script>
  </div>
</Layout>


