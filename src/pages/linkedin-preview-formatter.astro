---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';

// Page Metadata
const title = "LinkedIn Post Formatter & Preview Generator (Bold & Italic) | Get Micro Tools";
const description = "Free client-side LinkedIn text formatter and post preview simulator. Style text with bold/italic Unicode fonts and preview the exact 'see more' cutoff across desktop and mobile.";
const keywords = "linkedin text formatter, linkedin post preview, linkedin formatting tool, bold text linkedin, linkedin see more cutoff, linkedin hook generator";
const url = "https://getmicrotools.com/linkedin-preview-formatter";

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "LinkedIn Text Formatter & Post Preview Generator",
  "alternateName": [
    "LinkedIn Preview Tool",
    "LinkedIn Text Styler",
    "LinkedIn Hook & Cutoff Simulator"
  ],
  "url": "https://getmicrotools.com/linkedin-preview-formatter",
  "applicationCategory": "SocialNetworkingApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": "Free client-side LinkedIn text formatter to apply bold and italic Unicode formatting while simulating desktop and mobile feed preview cutoffs in real time.",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Get Micro Tools",
    "url": "https://getmicrotools.com"
  },
  "featureList": [
    "Real-time Unicode Bold and Italic font converter",
    "Desktop (210 chars) and Mobile (140 chars) feed truncation preview",
    "Media attachment mode simulating image/document feed height compression",
    "One-click clipboard copy with instant feedback",
    "Character and line counter with screen-reader accessibility best practices"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getmicrotools.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "LinkedIn Preview Formatter",
      "item": "https://getmicrotools.com/linkedin-preview-formatter"
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Format and Preview LinkedIn Posts for Maximum Engagement",
  "description": "A step-by-step workflow for styling LinkedIn post text and optimizing opening hooks before publishing.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Step 1: Draft Your Opening Hook",
      "text": "Write a punchy 1-2 sentence hook in the text workspace that introduces your core insight."
    },
    {
      "@type": "HowToStep",
      "name": "Step 2: Apply Strategic Bold or Italic Emphasis",
      "text": "Select your headline or key phrase and click 'Bold' or 'Italic' to apply Unicode emphasis to 2-3 words."
    },
    {
      "@type": "HowToStep",
      "name": "Step 3: Toggle Desktop and Mobile Previews",
      "text": "Switch between Desktop (210-char limit) and Mobile (140-char limit) to ensure your hook appears completely above the '...see more' fold."
    },
    {
      "@type": "HowToStep",
      "name": "Step 4: Copy and Paste into LinkedIn",
      "text": "Click 'Copy Formatted Text' to copy the formatted Unicode text to your clipboard, then paste directly into the LinkedIn post creator."
    }
  ]
};

const faqs = [
  {
    question: "How does Unicode formatting work on LinkedIn?",
    answer: "LinkedIn does not natively support rich-text Markdown (like HTML or native bolding) in standard post descriptions. Our tool converts standard Latin letters into Mathematical Alphanumeric Symbols from the Unicode standard (such as 𝗯𝗼𝗹𝗱 and 𝘪𝘵𝘢𝘭𝘪𝘤) that render universally across browsers and mobile apps."
  },
  {
    question: "Is using bold Unicode text bad for accessibility (Screen Readers)?",
    answer: "Yes, if overused. Screen readers (like NVDA or VoiceOver) interpret mathematical Unicode characters literally (e.g., 𝗯 is read as 'Mathematical Bold Small B'). To maintain accessibility, use bold or italic formatting solely for short 2–3 word headlines, labels, or bullet points—never for entire paragraphs."
  },
  {
    question: "Does styled Unicode text affect LinkedIn search SEO?",
    answer: "Yes. LinkedIn's internal search algorithm indexes standard ASCII text. Styled Unicode characters are not recognized as standard letters (e.g., searching for 'marketing' will not match '𝗺𝗮𝗿𝗸𝗲𝘁𝗶𝗻𝗴'). Keep your primary niche keywords in standard, unstyled plain text."
  },
  {
    question: "Where does the '...see more' cutoff happen on LinkedIn?",
    answer: "On desktop devices, LinkedIn typically truncates text after approximately 210 characters (or 3 lines). On mobile devices, the cutoff happens earlier, at approximately 140 characters (or 2 lines). When media or documents are attached, the cutoff tightens to roughly 100 characters."
  },
  {
    question: "What is the 1-3-1 post formatting rule on LinkedIn?",
    answer: "The 1-3-1 rule is a skimmable structure: 1 punchy opening hook line, followed by a 3-line concise context or story block, concluding with a 1-line key takeaway or call-to-action. This creates comfortable white space on mobile screens and maximizes click-through on 'see more'."
  }
];
---

<Layout title={title} description={description} keywords={keywords} url={url}>
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <main class="min-h-screen bg-canvas selection:bg-primary/20 transition-colors duration-500">
    <Nav />
    
    <header class="max-w-7xl mx-auto px-6 pt-16 pb-12">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-strong text-ink text-caption-uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Formatting Utility
        </div>
        <h1 class="text-display-lg md:text-display-mega text-ink mb-6">
          LinkedIn <span class="text-primary">Preview</span> & Formatter
        </h1>
        <p class="text-body-md text-muted max-w-2xl">
          Stand out in the professional feed with styled text and ensure your high-converting hook is fully visible before the 'see more' fold.
        </p>
      </div>
    </header>

    <section class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        
        <!-- Left: Workspace -->
        <div class="space-y-6">
          <div class="bg-surface-card border border-hairline rounded-lg overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.05)] transition-colors duration-500">
            <!-- Toolbar -->
            <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-canvas-soft border-b border-hairline transition-colors duration-500">
              <div class="flex items-center gap-2">
                <button id="btn-bold" class="px-3 py-1.5 text-xs font-semibold bg-white dark:bg-ink text-ink dark:text-canvas border border-hairline rounded hover:border-muted transition-all active:scale-95 cursor-pointer" title="Toggle Bold">𝗕 Bold</button>
                <button id="btn-italic" class="px-3 py-1.5 text-xs font-semibold bg-white dark:bg-ink text-ink dark:text-canvas border border-hairline rounded hover:border-muted transition-all active:scale-95 cursor-pointer" title="Toggle Italic">𝘐 Italic</button>
                <div class="h-4 w-px bg-hairline mx-1"></div>
                <button id="btn-clear" class="px-3 py-1.5 text-xs font-semibold text-muted hover:text-ink transition-all active:scale-95 cursor-pointer">Clear Text</button>
              </div>

              <!-- Contains Image/Media Toggle -->
              <label class="flex items-center gap-2 cursor-pointer select-none text-xs font-semibold text-muted hover:text-ink transition-colors duration-500 whitespace-nowrap flex-shrink-0">
                <input type="checkbox" id="media-toggle" class="sr-only peer" />
                <div class="relative w-8 h-4 bg-muted/20 dark:bg-white/10 rounded-full peer peer-focus:outline-none peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
                <span>Contains Image/Media</span>
              </label>
            </div>

            <!-- Input Area -->
            <div class="relative">
              <textarea
                id="post-input"
                class="w-full h-80 p-6 bg-transparent text-ink font-sans text-base leading-relaxed resize-none outline-none placeholder:text-muted-soft transition-colors duration-500"
                placeholder="Write your LinkedIn post here..."
              ></textarea>
              
              <div class="absolute bottom-4 right-6 flex items-center gap-2 px-2 py-1 bg-canvas/50 backdrop-blur-sm rounded text-[11px] font-semibold text-muted uppercase tracking-wider border border-hairline transition-colors duration-500">
                <span id="char-count">0</span> Characters
              </div>
            </div>
          </div>

          <!-- Action Button -->
          <button 
            id="copy-btn"
            class="w-full py-4 bg-primary hover:bg-primary-active text-white text-sm font-semibold rounded-md transition-all active:scale-[0.98] shadow-md shadow-primary/10 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span id="copy-btn-text">Copy Formatted Text</span>
            <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <svg id="success-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>

        <!-- Right: Preview -->
        <div class="sticky top-24">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-1 p-1 bg-surface-strong/50 rounded-lg border border-hairline">
              <button id="view-desktop" class="px-3 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded-md transition-all bg-white dark:bg-ink text-ink dark:text-canvas shadow-sm cursor-pointer">Desktop</button>
              <button id="view-mobile" class="px-3 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded-md transition-all text-muted hover:text-ink cursor-pointer">Mobile</button>
            </div>
            <div class="flex gap-1">
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
            </div>
          </div>

          <div id="preview-container" class="transition-all duration-300 w-full mx-auto">
            <!-- LinkedIn Card Mockup -->
            <div class="bg-white dark:bg-[#1d2226] border border-[#e0e0e0] dark:border-none rounded-lg overflow-hidden shadow-[0_0_0_1px_rgba(0,0,0,0.08)] transition-colors duration-500">
              <!-- Card Header -->
              <div class="p-3 pb-2 flex gap-2">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex-shrink-0 border border-black/5 flex items-center justify-center overflow-hidden">
                  <svg viewBox="0 0 24 24" class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <div class="pt-0.5 flex-grow">
                  <div class="flex items-center gap-1">
                    <span class="text-sm font-semibold text-black dark:text-white hover:text-primary hover:underline cursor-pointer">Alex Morgan</span>
                    <span class="text-xs text-muted"> • 1st</span>
                  </div>
                  <p class="text-[12px] text-muted leading-tight line-clamp-1">Head of Growth & Product Strategy | Scaling B2B SaaS</p>
                  <div class="flex items-center gap-1 mt-0.5 text-[12px] text-muted">
                    <span>1h • </span>
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" class="opacity-70"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 12a5 5 0 110-10 5 5 0 010 10zm.5-7.5h-1v3l2.5 1.5.5-.8-2-1.2v-2.5z"/></svg>
                  </div>
                </div>
                <button class="p-1 hover:bg-gray-100 dark:hover:bg-white/10 rounded-full transition-colors self-start text-muted">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M5 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm14 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-7 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                </button>
              </div>

              <!-- Post Content -->
              <div class="px-4 pb-4">
                <div id="preview-text" class="text-sm leading-[1.428] text-[#191919] dark:text-[#e1e1e1] whitespace-pre-wrap break-words min-h-[1.428em] transition-colors duration-500 font-sans">
                  <span class="text-muted-soft italic">Your preview will appear here...</span>
                </div>
              </div>

              <!-- Media Preview Area (Shown when media toggle is active) -->
              <div id="media-preview" class="hidden border-t border-gray-100 dark:border-[#2f3337] transition-all duration-300">
                <div class="bg-gray-50 dark:bg-[#1f262e] aspect-[1.91/1] w-full flex flex-col items-center justify-center text-muted select-none border-b border-gray-100 dark:border-[#2f3337] p-6 text-center">
                  <div class="p-3 rounded-full bg-white dark:bg-zinc-800 shadow-sm border border-gray-100 dark:border-zinc-700/50 mb-3 text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <h5 class="text-xs font-semibold text-ink mb-1">Image / PDF Document / Link Card</h5>
                  <p class="text-[10px] text-muted max-w-[200px]">LinkedIn tightens feed preview cutoffs when media is attached.</p>
                </div>
              </div>

              <!-- Card Footer -->
              <div class="px-3 border-t border-gray-100 dark:border-[#2f3337] transition-colors duration-500">
                <div class="flex items-center justify-around py-1">
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.46 11l-3.91-3.91a7 7 0 01-1.69-2.74l-.49-1.47a2.76 2.76 0 00-5.27 0l-.49 1.47a7 7 0 01-1.69 2.74L2.01 11a2.76 2.76 0 000 3.91l.89.89a2.8 2.8 0 003.92 0L8.5 14.12v5.12a2.76 2.76 0 002.76 2.76h1.47a2.76 2.76 0 002.76-2.76v-5.12l1.68 1.68a2.8 2.8 0 003.92 0l.89-.89a2.76 2.76 0 00-.52-3.91z"/></svg>
                    Like
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 00-10 10c0 2.25.75 4.33 2 6l-1 4 4-1a10 10 0 105-19z"/></svg>
                    Comment
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17 11V7l5 5-5 5v-4H7a4 4 0 00-4 4v1h-2v-1a6 6 0 016-6h8z"/></svg>
                    Repost
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"/></svg>
                    Send
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 p-6 bg-canvas-soft border border-hairline rounded-lg transition-colors duration-500">
            <h4 class="text-title-sm text-ink mb-2">Feed Truncation Mechanics</h4>
            <p class="text-body-sm leading-relaxed text-muted">
              On <strong class="text-ink">Mobile</strong>, the cutoff triggers at <strong class="text-ink">~140 characters</strong>. On <strong class="text-ink">Desktop</strong>, it extends to <strong class="text-ink">~210 characters</strong>. Posts with attached media truncate after <strong class="text-ink">~100 characters</strong>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational & Guidelines Section -->
    <section class="max-w-5xl mx-auto px-6 py-20 border-t border-hairline space-y-16">
      
      {/* Section 1: Accessibility & Unicode Technical Reality */}
      <div class="space-y-6">
        <div class="border-b border-hairline pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Technical Standards</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">Unicode Formatting: Screen Reader Accessibility & SEO</h2>
          <p class="text-sm text-muted mt-1">How mathematical alphanumeric Unicode characters function and how to format responsibly.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 text-red-500 font-semibold text-sm">
              <span>⚠️</span>
              <h3 class="font-bold uppercase tracking-wider text-xs">Screen Reader Impact</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              When software like VoiceOver or NVDA encounters styled Unicode, it spells out mathematical symbols character-by-character (e.g., <code>𝗯𝗼𝗹𝗱</code> is vocalized as <em>"Mathematical Bold Small B, Mathematical Bold Small O..."</em>). 
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg text-xs text-ink font-medium border border-hairline">
              <strong>Rule:</strong> Never format full sentences or paragraphs with Unicode. Restrict styling strictly to 2–3 word headlines or bullet titles.
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 text-primary font-semibold text-sm">
              <span>🔍</span>
              <h3 class="font-bold uppercase tracking-wider text-xs">Platform Search & Indexing</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              LinkedIn's internal search crawler indexes standard ASCII characters. Styled Unicode characters are treated as distinct math symbols, meaning searching for <code>marketing</code> will not surface a post written as <code>𝗺𝗮𝗿𝗸𝗲𝘁𝗶𝗻𝗴</code>.
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg text-xs text-ink font-medium border border-hairline">
              <strong>Rule:</strong> Keep your core industry keywords, hashtags, and author names in clean, unstyled standard text.
            </div>
          </div>
        </div>
      </div>

      {/* Section 2: High-Converting Hook Frameworks */}
      <div class="space-y-6">
        <div class="border-b border-hairline pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Copywriting Frameworks</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">4 Tested LinkedIn Hook Archetypes</h2>
          <p class="text-sm text-muted mt-1">Structure your opening 140 characters to maximize "see more" click-through rates.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">1. The Contrarian Reframe</h3>
              <span class="text-[10px] font-semibold text-primary bg-primary/10 px-2 py-0.5 rounded-full">High Dwell Time</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Challenges accepted industry dogma immediately, triggering intellectual curiosity to see the alternative.
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg font-mono text-xs text-ink border border-hairline-soft">
              Most teams think [Common Strategy] is the best way to grow.<br /><br />
              They are mistaken. Here is what we do instead: 👇
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">2. The Hard Numbers Case Study</h3>
              <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-500/10 px-2 py-0.5 rounded-full">Proof Driven</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Opens with specific financial, traffic, or efficiency data to establish instant authority.
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg font-mono text-xs text-ink border border-hairline-soft">
              We spent $42,500 testing [Channel] over the last 90 days.<br /><br />
              The 3 unexpected findings every founder should know:
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">3. The Framework Playbook</h3>
              <span class="text-[10px] font-semibold text-blue-600 bg-blue-500/10 px-2 py-0.5 rounded-full">Save & Repost Magnet</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Promises a step-by-step resolution to a common workflow bottleneck.
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg font-mono text-xs text-ink border border-hairline-soft">
              How to [Achieve Goal] in [Timeframe] without [Biggest Pain Point]:<br /><br />
              Our complete 5-step operating playbook: 🧵
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-ink">4. The Costly Mistake Story</h3>
              <span class="text-[10px] font-semibold text-amber-600 bg-amber-500/10 px-2 py-0.5 rounded-full">Authenticity</span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Leverages vulnerability and personal learning to build deep audience connection.
            </p>
            <div class="p-3 bg-canvas-soft rounded-lg font-mono text-xs text-ink border border-hairline-soft">
