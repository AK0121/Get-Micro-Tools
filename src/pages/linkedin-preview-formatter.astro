---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';

// Page Metadata
const title = "LinkedIn Post Formatter & Preview Tool (Bold & Italic) | Get Micro Tools";
const description = "Format bold and italic text for LinkedIn using Unicode characters and preview desktop and mobile 'see more' cutoff limits before posting.";
const keywords = "linkedin post formatter, linkedin text formatter, bold text for linkedin, linkedin text styling, linkedin preview simulator, bold text linkedin";
const url = "https://getmicrotools.com/linkedin-preview-formatter";

const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "LinkedIn Post Formatter & Feed Preview",
  "alternateName": [
    "LinkedIn Text Formatter",
    "LinkedIn Post Preview Tool",
    "Bold Text for LinkedIn",
    "LinkedIn Cutoff Preview Simulator"
  ],
  "url": "https://getmicrotools.com/linkedin-preview-formatter",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": "Free client-side LinkedIn text formatter to apply bold, italic, and bold-italic Unicode formatting while simulating desktop and mobile feed preview cutoffs in real time.",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Get Micro Tools",
    "url": "https://getmicrotools.com"
  },
  "featureList": [
    "Unicode Bold, Italic, and Bold-Italic text formatting for Latin characters and numerals",
    "Desktop (210 chars) and Mobile (140 chars) feed truncation preview simulator",
    "Media attachment mode simulating image, document carousel, and link card cutoff compression (~100 chars)",
    "One-click clipboard copy with visual confirmation",
    "Real-time character counter and plain-text conversion tools"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getmicrotools.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "LinkedIn Post Formatter",
      "item": "https://getmicrotools.com/linkedin-preview-formatter"
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Format and Preview a LinkedIn Post",
  "description": "A practical workflow for applying bold and italic Unicode styling and checking feed preview cutoffs before publishing on LinkedIn.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Step 1: Write or Paste Your Draft",
      "text": "Enter your post text into the workspace editor. Keep an eye on the character counter to track your total post length."
    },
    {
      "@type": "HowToStep",
      "name": "Step 2: Apply Bold or Italic Styling to Specific Words",
      "text": "Select the specific words or section labels you wish to emphasize and click 'Bold' or 'Italic'. Avoid formatting entire sentences to maintain accessibility."
    },
    {
      "@type": "HowToStep",
      "name": "Step 3: Check Desktop and Mobile Feed Cutoffs",
      "text": "Toggle between Desktop (approx. 210 characters) and Mobile (approx. 140 characters) views to ensure your opening lines appear above the '...see more' fold. If you plan to attach media, turn on the 'Contains Image/Media' toggle."
    },
    {
      "@type": "HowToStep",
      "name": "Step 4: Copy and Paste into LinkedIn",
      "text": "Click 'Copy Formatted Text' to copy the text to your clipboard, then paste it directly into LinkedIn's post composer."
    }
  ]
};

const faqs = [
  {
    question: "Why doesn't LinkedIn support native bold and italic formatting in regular posts?",
    answer: "LinkedIn's standard feed post composer accepts plain text only. It strips HTML tags and displays Markdown syntax (such as **bold** or *italic*) as literal asterisks. Native rich-text formatting (bold, italic, numbered lists, blockquotes) is only available inside LinkedIn Articles and Newsletters, which use a dedicated long-form editor rather than the feed composer."
  },
  {
    question: "How does this tool generate bold and italic text for LinkedIn?",
    answer: "Because LinkedIn's feed composer only accepts plain text, this tool converts standard Latin letters and numerals into corresponding glyphs from the Unicode Mathematical Alphanumeric Symbols block (U+1D400–U+1D7FF). Modern operating systems and web browsers render these mathematical symbols with bold or italic weights, even though LinkedIn treats them as plain characters."
  },
  {
    question: "Which characters and styles does this tool support?",
    answer: "This tool supports Bold (Latin letters A–Z, a–z, and digits 0–9), Italic (Latin letters A–Z, a–z), and Bold-Italic (Latin letters A–Z, a–z). It does not style punctuation, spaces, or emojis. It also does not support italic numerals (the Unicode mathematical italic block has no separate italic digits), non-Latin alphabets (such as Cyrillic, Greek, Arabic, or CJK characters), or decorative styles like underline, strikethrough, monospace, or script fonts."
  },
  {
    question: "How do I format and copy text to paste into LinkedIn?",
    answer: "Type or paste your text into the workspace editor. Highlight the specific words or labels you wish to style, then click '𝗕 Bold' or '𝘐 Italic' in the toolbar. Once your post looks right in the preview, click 'Copy Formatted Text'. Open LinkedIn, click 'Start a post', and press Ctrl+V (or Cmd+V on Mac) to paste the styled text into your post."
  },
  {
    question: "Can screen readers read bold or italic Unicode text?",
    answer: "Screen readers (such as NVDA, JAWS, Apple VoiceOver, and Android TalkBack) often interpret Mathematical Alphanumeric Symbols literally according to their Unicode character specifications. Instead of pronouncing a word normally, a screen reader may announce each letter phonetically (for example, reading 𝗯-𝗼-𝗹-𝗱 as 'Mathematical Bold Small B, Mathematical Bold Small O...'). To maintain accessibility, never format entire sentences or paragraphs with Unicode; limit styling strictly to short 1–3 word labels."
  },
  {
    question: "Does using bold or italic Unicode text hurt my search visibility on LinkedIn?",
    answer: "Yes, it can. LinkedIn's internal search algorithm and feed indexing systems index standard ASCII characters. When you replace letters with mathematical Unicode symbols, LinkedIn does not automatically map them back to standard letters. If a user searches for 'project management', a post containing '𝗽𝗿𝗼𝗷𝗲𝗰𝘁 𝗺𝗮𝗻𝗮𝗴𝗲𝗺𝗲𝗻𝘁' may not match the search query. Keep your primary keywords, hashtags, and author names in standard plain text."
  },
  {
    question: "Where does LinkedIn cut off text with the '...see more' button?",
    answer: "On mobile devices, LinkedIn truncates standard text posts after approximately 140 characters or up to 3 lines, whichever comes first. On desktop screens, the cutoff is approximately 210 characters or 3 lines. When a post includes an image, document carousel, or video attachment, LinkedIn tightens the preview area to roughly 100 characters or 1 line break."
  },
  {
    question: "Will the formatted text look the same on iPhones, Android phones, and PCs?",
    answer: "Most modern mobile and desktop operating systems (iOS, Android, Windows 10/11, macOS) include system fonts that support Mathematical Alphanumeric Symbols. However, older operating systems, customized enterprise browser environments, or certain email digest clients may lack complete Unicode font coverage and display missing characters as empty boxes ('tofu' glyphs like ▯)."
  },
  {
    question: "What is the difference between a LinkedIn feed post and a LinkedIn Article?",
    answer: "A LinkedIn feed post is limited to 3,000 characters, accepts plain text only, and appears directly in the feed. A LinkedIn Article is a long-form publishing format (accessed by clicking 'Write article' on desktop) with a full rich-text editor that supports native bold, italic, H1/H2 headings, bulleted lists, embedded hyperlinks, and images without using Unicode replacement."
  }
];
---

<Layout title={title} description={description} keywords={keywords} url={url}>
  <script type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <main class="min-h-screen bg-canvas selection:bg-primary/20 transition-colors duration-500">
    <Nav />
    
    <header class="max-w-7xl mx-auto px-6 pt-16 pb-12">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-strong text-ink text-caption-uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          Formatting & Feed Preview Utility
        </div>
        <h1 class="text-display-lg md:text-display-mega text-ink mb-6">
          LinkedIn <span class="text-primary">Post Formatter</span> & Feed Preview
        </h1>
        <p class="text-body-md text-muted max-w-2xl leading-relaxed">
          Format bold and italic text for LinkedIn using Unicode characters, simulate desktop and mobile &ldquo;see more&rdquo; cutoff limits, and copy your formatted post ready to publish.
        </p>
      </div>
    </header>

    <section class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        
        <!-- Left: Workspace -->
        <div class="space-y-6">
          <div class="bg-surface-card border border-hairline rounded-lg overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.05)] transition-colors duration-500">
            <!-- Toolbar -->
            <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-canvas-soft border-b border-hairline transition-colors duration-500">
              <div class="flex items-center gap-2">
                <button id="btn-bold" class="px-3 py-1.5 text-xs font-semibold bg-white dark:bg-ink text-ink dark:text-canvas border border-hairline rounded hover:border-muted transition-all active:scale-95 cursor-pointer" title="Toggle Bold">𝗕 Bold</button>
                <button id="btn-italic" class="px-3 py-1.5 text-xs font-semibold bg-white dark:bg-ink text-ink dark:text-canvas border border-hairline rounded hover:border-muted transition-all active:scale-95 cursor-pointer" title="Toggle Italic">𝘐 Italic</button>
                <div class="h-4 w-px bg-hairline mx-1"></div>
                <button id="btn-clear" class="px-3 py-1.5 text-xs font-semibold text-muted hover:text-ink transition-all active:scale-95 cursor-pointer">Clear Text</button>
              </div>

              <!-- Contains Image/Media Toggle -->
              <label class="flex items-center gap-2 cursor-pointer select-none text-xs font-semibold text-muted hover:text-ink transition-colors duration-500 whitespace-nowrap flex-shrink-0">
                <input type="checkbox" id="media-toggle" class="sr-only peer" />
                <div class="relative w-8 h-4 bg-muted/20 dark:bg-white/10 rounded-full peer peer-focus:outline-none peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
                <span>Contains Image/Media</span>
              </label>
            </div>

            <!-- Input Area -->
            <div class="relative">
              <textarea
                id="post-input"
                class="w-full h-80 p-6 bg-transparent text-ink font-sans text-base leading-relaxed resize-none outline-none placeholder:text-muted-soft transition-colors duration-500"
                placeholder="Write or paste your LinkedIn post here..."
              ></textarea>
              
              <div class="absolute bottom-4 right-6 flex items-center gap-2 px-2 py-1 bg-canvas/50 backdrop-blur-sm rounded text-[11px] font-semibold text-muted uppercase tracking-wider border border-hairline transition-colors duration-500">
                <span id="char-count">0</span> Characters
              </div>
            </div>
          </div>

          <!-- Action Button -->
          <button 
            id="copy-btn"
            class="w-full py-4 bg-primary hover:bg-primary-active text-white text-sm font-semibold rounded-md transition-all active:scale-[0.98] shadow-md shadow-primary/10 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span id="copy-btn-text">Copy Formatted Text</span>
            <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <svg id="success-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </button>
        </div>

        <!-- Right: Preview -->
        <div class="sticky top-24">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-1 p-1 bg-surface-strong/50 rounded-lg border border-hairline">
              <button id="view-desktop" class="px-3 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded-md transition-all bg-white dark:bg-ink text-ink dark:text-canvas shadow-sm cursor-pointer">Desktop</button>
              <button id="view-mobile" class="px-3 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded-md transition-all text-muted hover:text-ink cursor-pointer">Mobile</button>
            </div>
            <div class="flex gap-1">
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-hairline-strong"></div>
            </div>
          </div>

          <div id="preview-container" class="transition-all duration-300 w-full mx-auto">
            <!-- LinkedIn Card Mockup -->
            <div class="bg-white dark:bg-[#1d2226] border border-[#e0e0e0] dark:border-none rounded-lg overflow-hidden shadow-[0_0_0_1px_rgba(0,0,0,0.08)] transition-colors duration-500">
              <!-- Card Header -->
              <div class="p-3 pb-2 flex gap-2">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex-shrink-0 border border-black/5 flex items-center justify-center overflow-hidden">
                  <svg viewBox="0 0 24 24" class="w-8 h-8 text-gray-400 dark:text-gray-500" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <div class="pt-0.5 flex-grow">
                  <div class="flex items-center gap-1">
                    <span class="text-sm font-semibold text-black dark:text-white hover:text-primary hover:underline cursor-pointer">Alex Morgan</span>
                    <span class="text-xs text-muted"> • 1st</span>
                  </div>
                  <p class="text-[12px] text-muted leading-tight line-clamp-1">Product Strategy & Operations</p>
                  <div class="flex items-center gap-1 mt-0.5 text-[12px] text-muted">
                    <span>1h • </span>
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" class="opacity-70"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 12a5 5 0 110-10 5 5 0 010 10zm.5-7.5h-1v3l2.5 1.5.5-.8-2-1.2v-2.5z"/></svg>
                  </div>
                </div>
                <button class="p-1 hover:bg-gray-100 dark:hover:bg-white/10 rounded-full transition-colors self-start text-muted">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M5 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm14 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-7 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                </button>
              </div>

              <!-- Post Content -->
              <div class="px-4 pb-4">
                <div id="preview-text" class="text-sm leading-[1.428] text-[#191919] dark:text-[#e1e1e1] whitespace-pre-wrap break-words min-h-[1.428em] transition-colors duration-500 font-sans">
                  <span class="text-muted-soft italic">Your preview will appear here...</span>
                </div>
              </div>

              <!-- Media Preview Area (Shown when media toggle is active) -->
              <div id="media-preview" class="hidden border-t border-gray-100 dark:border-[#2f3337] transition-all duration-300">
                <div class="bg-gray-50 dark:bg-[#1f262e] aspect-[1.91/1] w-full flex flex-col items-center justify-center text-muted select-none border-b border-gray-100 dark:border-[#2f3337] p-6 text-center">
                  <div class="p-3 rounded-full bg-white dark:bg-zinc-800 shadow-sm border border-gray-100 dark:border-zinc-700/50 mb-3 text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <h5 class="text-xs font-semibold text-ink mb-1">Image / Document Carousel / Link Card</h5>
                  <p class="text-[10px] text-muted max-w-[220px]">LinkedIn tightens feed preview cutoffs when an image, document, or card is attached.</p>
                </div>
              </div>

              <!-- Card Footer -->
              <div class="px-3 border-t border-gray-100 dark:border-[#2f3337] transition-colors duration-500">
                <div class="flex items-center justify-around py-1">
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.46 11l-3.91-3.91a7 7 0 01-1.69-2.74l-.49-1.47a2.76 2.76 0 00-5.27 0l-.49 1.47a7 7 0 01-1.69 2.74L2.01 11a2.76 2.76 0 000 3.91l.89.89a2.8 2.8 0 003.92 0L8.5 14.12v5.12a2.76 2.76 0 002.76 2.76h1.47a2.76 2.76 0 002.76-2.76v-5.12l1.68 1.68a2.8 2.8 0 003.92 0l.89-.89a2.76 2.76 0 00-.52-3.91z"/></svg>
                    Like
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 00-10 10c0 2.25.75 4.33 2 6l-1 4 4-1a10 10 0 105-19z"/></svg>
                    Comment
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17 11V7l5 5-5 5v-4H7a4 4 0 00-4 4v1h-2v-1a6 6 0 016-6h8z"/></svg>
                    Repost
                  </button>
                  <button class="flex items-center gap-1.5 px-3 py-2 rounded hover:bg-gray-100 dark:hover:bg-white/10 text-muted hover:text-ink font-semibold text-sm transition-colors">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z"/></svg>
                    Send
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 p-6 bg-canvas-soft border border-hairline rounded-lg transition-colors duration-500">
            <h4 class="text-title-sm text-ink mb-2">Feed Truncation Thresholds</h4>
            <p class="text-body-sm leading-relaxed text-muted">
              In standard text posts, <strong class="text-ink">Mobile</strong> truncates after approximately <strong class="text-ink">140 characters</strong> (or 3 lines). On <strong class="text-ink">Desktop</strong>, the cutoff occurs at approximately <strong class="text-ink">210 characters</strong> (or 3 lines). Posts with attached media truncate after approximately <strong class="text-ink">100 characters</strong> (or 1 line break).
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational & Guidelines Section -->
    <section class="max-w-5xl mx-auto px-6 py-20 border-t border-hairline space-y-20">
      
      {/* Section 1: How the Formatter Controls Work */}
      <div class="space-y-6">
        <div class="border-b border-hairline pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Tool Operation</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">How to Format, Preview, and Copy Your Post</h2>
          <p class="text-sm text-muted mt-1">Understanding the editor toolbar, simulation switches, and clipboard actions.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 font-semibold text-sm text-ink">
              <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono">1</span>
              <h3 class="font-bold text-sm text-ink">Drafting & Character Tracking</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Type or paste your text into the workspace editor. The real-time character counter at the bottom counts characters using JavaScript array clustering, ensuring that multi-byte Unicode characters are accurately tallied against LinkedIn&rsquo;s 3,000-character post limit.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 font-semibold text-sm text-ink">
              <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono">2</span>
              <h3 class="font-bold text-sm text-ink">Applying Bold and Italic Styling</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Highlight the specific words or labels you want to style, then click <strong class="text-ink">𝗕 Bold</strong> or <strong class="text-ink">𝘐 Italic</strong> in the toolbar. Clicking either button again removes that style. If no text is selected, the buttons toggle active styling for subsequent typing or apply styling across the entire draft.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 font-semibold text-sm text-ink">
              <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono">3</span>
              <h3 class="font-bold text-sm text-ink">Desktop vs. Mobile Preview Simulator</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Switch between <strong class="text-ink">Desktop</strong> and <strong class="text-ink">Mobile</strong> views to inspect how your opening hook appears above the fold. The preview card models LinkedIn&rsquo;s real feed constraints, inserting the &ldquo;...see more&rdquo; cutoff when character limits or line break maximums are reached.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-3">
            <div class="flex items-center gap-2 font-semibold text-sm text-ink">
              <span class="w-6 h-6 rounded-full bg-primary/10 text-primary text-xs flex items-center justify-center font-mono">4</span>
              <h3 class="font-bold text-sm text-ink">Media Mode & Clipboard Copy</h3>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Turn on the <strong class="text-ink">Contains Image/Media</strong> toggle if you are uploading an image, carousel PDF, or link preview. When ready, click <strong class="text-ink">Copy Formatted Text</strong> to transfer the styled Unicode text to your clipboard, then paste it directly into LinkedIn with Ctrl+V (or Cmd+V).
            </p>
          </div>
        </div>
      </div>

      {/* Section 2: Ordinary Text vs. Unicode Characters */}
      <div class="space-y-6">
        <div class="border-b border-hairline pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Technical Fundamentals</span>
          <h2 class="text-2xl md:text-3xl font-bold text-ink tracking-tight mt-1">Ordinary Text vs. Unicode Character Substitution</h2>
          <p class="text-sm text-muted mt-1">How mathematical Unicode symbols imitate font styles in a plain-text composer.</p>
        </div>

        <div class="p-6 rounded-2xl bg-surface-card border border-hairline space-y-4">
          <h3 class="text-base font-bold text-ink">Why LinkedIn Feed Posts Do Not Support Native Bold or Italic</h3>
          <p class="text-sm text-muted leading-relaxed">
            In standard rich-text environments (such as Microsoft Word, Google Docs, or HTML web pages), bold and italic styling are stored as formatting metadata (<code class="text-ink bg-canvas-soft px-1.5 py-0.5 rounded">&lt;strong&gt;</code>, <code class="text-ink bg-canvas-soft px-1.5 py-0.5 rounded">&lt;em&gt;</code>, or Markdown <code class="text-ink bg-canvas-soft px-1.5 py-0.5 rounded">**bold**</code>). The underlying characters remain standard ASCII characters (<code class="text-ink bg-canvas-soft px-1.5 py-0.5 rounded">a</code> is still byte value 0x61).
          </p>
          <p class="text-sm text-muted leading-relaxed">
            The standard LinkedIn feed composer is strictly a plain-text input field. It strips HTML tags and prints Markdown asterisks as literal characters. To display text with bold or italic weights in the feed, formatters substitute standard Latin characters with alternate symbols from the <strong class="text-ink">Unicode Mathematical Alphanumeric Symbols</strong> block (range U+1D400–U+1D7FF).
          </p>
        </div>

