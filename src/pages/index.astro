---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ToolCard from '../components/ToolCard.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const featuredTools = [
  {
    title: "ROI Calculator",
    description: "Calculate Return on Investment (ROI), Net Gain, and Annualized Growth (CAGR) for capital & marketing spend.",
    icon: "roi",
    tag: "FINANCE",
    href: "/roi-calculator"
  },
  {
    title: "Instagram Engagement Rate Calculator",
    description: "Calculate your Instagram Engagement Rate by Reach (ERR) and Followers (ERF) with creator-tier benchmarks.",
    icon: "engagement",
    tag: "CREATOR",
    href: "/instagram-engagement-rate-calculator"
  },
  {
    title: "Instagram Reels Overlay Tester",
    description: "Upload your media to visually check if native app captions or UI icons block your text safe zones.",
    icon: "reels",
    tag: "VIDEO",
    href: "/instagram-reels-overlay-tester"
  },
  {
    title: "ROAS & Profitability Engine",
    description: "Calculate exact Return on Ad Spend, break-even points, and net profits for Meta and Google campaigns.",
    icon: "roas",
    tag: "MARKETING",
    href: "/roas-calculator"
  },
  {
    title: "LinkedIn Preview Formatter",
    description: "Style your LinkedIn posts with bold and italic text while previewing exactly where the 'see more' cutoff will land.",
    icon: "linkedin",
    tag: "SOCIAL",
    href: "/linkedin-preview-formatter"
  },
  {
    title: "TikTok Bio Checker",
    description: "Check your TikTok bio against the official 80-character limit with live counters, progress indicator, and profile mockup.",
    icon: "tiktok",
    tag: "CREATOR",
    href: "/tiktok-bio-checker"
  }
];

const categories = ["ALL", "CREATOR", "MARKETING", "FINANCE", "VIDEO", "SOCIAL"];
---

<Layout 
	title="Get Micro Tools | Free All-in-One Utilities for Digital Creators"
	description="Access professional-grade tools for engagement calculation, Reels safe zones, ROAS analysis, and LinkedIn formatting. Minimalist, fast, and free for creators."
	keywords="creator tools, instagram engagement rate calculator, reels safe zone tester, roas calculator, linkedin text formatter, social media marketing tools"
>
	<main class="min-h-screen">
		<Nav />
		<Hero />
		<HowItWorks />
		
		<section id="tools" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
			<!-- Subtle ambient backdrop glow -->
			<div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary/5 rounded-full blur-[140px] pointer-events-none -z-10" aria-hidden="true"></div>

			<!-- Section Header & Filter Controls -->
			<div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-10 sm:mb-12 gap-6">
				<div class="max-w-xl">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-semibold text-primary mb-3">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
						</span>
						<span>FREE UTILITIES SUITE</span>
					</div>
					<h2 class="text-display-lg text-ink mb-4">Essential tools for modern creators.</h2>
					<p class="text-body text-sm sm:text-base leading-relaxed">Stop guessing your numbers. Access professional-grade utilities in a single, fast interface designed for high-growth creators and marketers.</p>
				</div>

				<!-- Category Filter Pills & Live Count -->
				<div class="flex flex-col sm:items-end gap-2.5 w-full lg:w-auto">
					<span id="tool-counter" class="text-xs font-mono text-muted">Showing all 6 tools</span>
					<div class="flex items-center gap-1.5 p-1 bg-surface-card border border-hairline rounded-xl overflow-x-auto max-w-full shadow-2xs">
						{categories.map((cat, idx) => (
							<button 
								type="button" 
								data-filter={cat.toLowerCase()}
								class={`filter-btn px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 cursor-pointer whitespace-nowrap ${idx === 0 ? 'bg-primary text-canvas font-semibold shadow-xs' : 'text-body hover:text-ink hover:bg-canvas-soft'}`}
							>
								{cat === "ALL" ? "All Tools" : cat.charAt(0) + cat.slice(1).toLowerCase()}
							</button>
						))}
					</div>
				</div>
			</div>
			
			<!-- Responsive 3-Column Tools Grid -->
			<div id="tools-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-7">
				{featuredTools.map((tool, idx) => (
					<ToolCard {...tool} index={idx} />
				))}
			</div>

			<!-- Dynamic Empty State -->
			<div id="no-tools-message" class="hidden text-center py-16 border border-dashed border-hairline rounded-2xl bg-surface-card/40 mt-6">
				<p class="text-body text-sm">No tools found matching this category.</p>
				<button type="button" id="reset-filter-btn" class="mt-3 text-xs font-semibold text-primary hover:underline cursor-pointer">
					Reset to All Tools
				</button>
			</div>
		</section>

		<script>
			function setupToolFilters() {
				const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
				const toolCards = document.querySelectorAll<HTMLElement>('[data-tool-card]');
				const counter = document.getElementById('tool-counter');
				const emptyState = document.getElementById('no-tools-message');
				const resetBtn = document.getElementById('reset-filter-btn');

				if (!filterButtons.length || !toolCards.length) return;

				function filterTools(category: string) {
					let visibleCount = 0;

					toolCards.forEach(card => {
						const cardCategory = card.dataset.category || '';
						const match = category === 'all' || cardCategory === category;
						
						if (match) {
							card.style.display = 'flex';
							visibleCount++;
						} else {
							card.style.display = 'none';
						}
					});

					// Update button styles
					filterButtons.forEach(btn => {
						const btnCat = btn.dataset.filter;
						if (btnCat === category) {
							btn.className = 'filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary text-canvas shadow-xs transition-all duration-200 cursor-pointer whitespace-nowrap';
						} else {
							btn.className = 'filter-btn px-3 py-1.5 text-xs font-medium rounded-lg text-body hover:text-ink hover:bg-canvas-soft transition-all duration-200 cursor-pointer whitespace-nowrap';
						}
					});

					// Update counter
					if (counter) {
						if (category === 'all') {
							counter.textContent = `Showing all ${toolCards.length} tools`;
						} else {
							counter.textContent = `Showing ${visibleCount} ${category} ${visibleCount === 1 ? 'tool' : 'tools'}`;
						}
					}

					// Update empty state
					if (emptyState) {
						if (visibleCount === 0) {
							emptyState.classList.remove('hidden');
						} else {
							emptyState.classList.add('hidden');
						}
					}
				}

				filterButtons.forEach(btn => {
					btn.addEventListener('click', () => {
						const category = btn.dataset.filter || 'all';
						filterTools(category);
					});
				});

				if (resetBtn) {
					resetBtn.addEventListener('click', () => {
						filterTools('all');
					});
				}
			}

			// Setup on DOM load and Astro transitions
			setupToolFilters();
			document.addEventListener('astro:page-load', setupToolFilters);
		</script>

		<FAQ />

		<Footer />
	</main>
</Layout>
