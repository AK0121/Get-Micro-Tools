---
interface Props {
  title: string;
  description: string;
  icon: string;
  tag?: string;
  href: string;
}

const { title, description, icon, tag, href } = Astro.props;

// Determine icon key based on icon prop or title string
const getIconKey = (iconProp: string, titleProp: string) => {
  const t = titleProp.toLowerCase();
  if (iconProp === "roi" || t.includes("roi calculator")) return "roi";
  if (iconProp === "engagement" || t.includes("engagement")) return "engagement";
  if (iconProp === "reels" || t.includes("reels")) return "reels";
  if (iconProp === "roas" || t.includes("roas")) return "roas";
  if (iconProp === "linkedin" || t.includes("linkedin")) return "linkedin";
  return iconProp;
};

const iconKey = getIconKey(icon, title);
---

<a 
  href={href} 
  class="group relative flex flex-col justify-between h-full bg-surface-card border border-hairline rounded-lg p-6 sm:p-7 transition-all duration-200 hover:border-hairline-strong hover:shadow-md hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
>
  <div class="space-y-4">
    <!-- Tool Name & Icon Header -->
    <div class="flex items-start gap-3.5">
      <div class="shrink-0 w-11 h-11 rounded-lg bg-canvas border border-hairline flex items-center justify-center shadow-2xs group-hover:border-primary/30 group-hover:bg-canvas-soft transition-colors duration-200">
        {iconKey === "roi" ? (
          <!-- Finance / Bar Chart Icon -->
          <svg class="w-5 h-5 text-ink group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
          </svg>
        ) : iconKey === "engagement" ? (
          <!-- Growth / Engagement Trend Icon -->
          <svg class="w-5 h-5 text-ink group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 005.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
          </svg>
        ) : iconKey === "reels" ? (
          <!-- Mobile Device / Video Tester Icon -->
          <svg class="w-5 h-5 text-ink group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
          </svg>
        ) : iconKey === "roas" ? (
          <!-- Revenue / Currency Target Icon -->
          <svg class="w-5 h-5 text-ink group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-9h4.5a2.25 2.25 0 010 4.5H9a2.25 2.25 0 000 4.5h4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        ) : iconKey === "linkedin" ? (
          <!-- Typography / Text Editor Icon -->
          <svg class="w-5 h-5 text-ink group-hover:text-primary transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
          </svg>
        ) : (
          <span class="text-xl" aria-hidden="true">{icon}</span>
        )}
      </div>
      <div class="pt-0.5 min-w-0 flex-1">
        <h3 class="text-base sm:text-lg font-semibold text-ink group-hover:text-primary transition-colors duration-200 leading-snug tracking-tight">
          {title}
        </h3>
      </div>
    </div>
    
    <!-- What it does (Description) -->
    <p class="text-body text-sm leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <!-- Category & Action Footer -->
  <div class="mt-6 pt-4 border-t border-hairline-soft flex items-center justify-between gap-3">
    {tag ? (
      <span class="inline-flex items-center text-[10px] font-mono font-semibold uppercase tracking-wider text-muted bg-canvas-soft border border-hairline px-2.5 py-1 rounded-md group-hover:border-hairline-strong/60 transition-colors">
        {tag}
      </span>
    ) : (
      <div />
    )}
    
    <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-ink group-hover:text-primary transition-colors duration-200 ml-auto shrink-0">
      <span>Try it now</span>
      <svg 
        xmlns="http://www.w3.org/2000/svg" 
        class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</a>



