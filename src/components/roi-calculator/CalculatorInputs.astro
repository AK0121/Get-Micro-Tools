---
---

<div class="lg:col-span-7 space-y-6">
  <div class="flex items-center justify-between border-b border-hairline-soft pb-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">02. Data Input</span>
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wider">Financial Variables</h3>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <button 
        type="button" 
        id="reset-roi-btn" 
        class="px-2.5 py-1 text-xs font-semibold text-muted hover:text-ink hover:bg-surface-strong rounded-md border border-hairline transition-all flex items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs cursor-pointer"
        title="Reset all fields to default"
      >
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset Calculator</span>
      </button>
      <span class="text-[11px] text-muted font-medium hidden sm:flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span> Live Calculation
      </span>
    </div>
  </div>

  {/* Group 1: Core Financial Values Panel */}
  <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-4">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span class="text-sm">💵</span> Investment Capital & Revenue
      </span>
      <span class="text-[10px] text-muted font-normal">Primary financial inputs</span>
    </div>

    {/* Currency Dropdown */}
    <div class="space-y-1.5">
      <label for="roi-currency" class="text-xs font-semibold text-ink flex items-center justify-between">
        <span>Display Currency</span>
        <span class="text-[10px] text-muted font-normal">Global formatting</span>
      </label>
      <select 
        id="roi-currency" 
        class="w-full bg-surface-card border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm shadow-2xs cursor-pointer"
      >
        <option value="$" selected>USD - US Dollar ($)</option>
        <option value="€">EUR - Euro (€)</option>
        <option value="£">GBP - British Pound (£)</option>
        <option value="₹">INR - Indian Rupee (₹)</option>
        <option value="¥">JPY - Japanese Yen (¥)</option>
        <option value="A$">AUD - Australian Dollar (A$)</option>
        <option value="C$">CAD - Canadian Dollar (C$)</option>
        <option value="CHF">CHF - Swiss Franc (Fr)</option>
        <option value="S$">SGD - Singapore Dollar (S$)</option>
        <option value="AED">AED - UAE Dirham (د.إ)</option>
      </select>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {/* Initial Investment */}
      <div class="space-y-2">
        <label for="roi-initial-investment" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span id="label-initial-investment">Initial Investment</span>
          <span class="text-[10px] text-muted font-normal">Outlay / Spend</span>
        </label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted currency-symbol font-mono font-medium text-sm">$</span>
          <input 
            type="number" 
            id="roi-initial-investment" 
            min="0" 
            step="any"
            placeholder="10000" 
            aria-describedby="initial-hint initial-error"
            class="w-full bg-surface-card border border-hairline rounded-lg pl-9 pr-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm aria-invalid:border-red-500 shadow-2xs" 
          />
        </div>
        <p id="initial-hint" class="text-[11px] text-muted leading-tight">Total capital invested or campaign cost</p>
        <p id="initial-error" class="text-[11px] text-red-500 font-medium hidden flex items-center gap-1">
          <span>⚠️</span> <span id="initial-error-text">Investment amount must be non-negative.</span>
        </p>
      </div>

      {/* Final Return */}
      <div class="space-y-2">
        <label for="roi-final-return" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span id="label-final-return">Final Return</span>
          <span class="text-[10px] text-muted font-normal">Total Proceeds / Revenue</span>
        </label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted currency-symbol font-mono font-medium text-sm">$</span>
          <input 
            type="number" 
            id="roi-final-return" 
            min="0" 
            step="any"
            placeholder="15000" 
            aria-describedby="return-hint return-error"
            class="w-full bg-surface-card border border-hairline rounded-lg pl-9 pr-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm aria-invalid:border-red-500 shadow-2xs" 
          />
        </div>
        <p id="return-hint" class="text-[11px] text-muted leading-tight">Total gross value or revenue generated</p>
        <p id="return-error" class="text-[11px] text-red-500 font-medium hidden flex items-center gap-1">
          <span>⚠️</span> <span id="return-error-text">Return amount must be non-negative.</span>
        </p>
      </div>
    </div>

    {/* Marketing Profit Margin (Visible only in Marketing mode) */}
    <div id="roi-margin-container" class="hidden space-y-2 pt-2 border-t border-hairline-soft">
      <label for="roi-profit-margin" class="text-xs font-semibold text-ink flex items-center justify-between">
        <span>Gross Profit Margin (%)</span>
        <span class="text-[10px] text-muted font-normal">COGS Adjustment</span>
      </label>
      <div class="relative">
        <input 
          type="number" 
          id="roi-profit-margin" 
          min="0" 
          max="100"
          step="any"
          value="100"
          placeholder="100" 
          aria-describedby="margin-hint"
          class="w-full bg-surface-card border border-hairline rounded-lg pl-3.5 pr-9 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm shadow-2xs" 
        />
        <span class="absolute right-3.5 top-1/2 -translate-y-1/2 text-muted font-mono font-medium text-sm">%</span>
      </div>
      <p id="margin-hint" class="text-[11px] text-muted leading-tight">Percentage of sales retained after Cost of Goods Sold (e.g. 40% margin means COGS is 60%)</p>
    </div>
  </div>

  {/* Group 2: Investment Time Horizon Panel (Optional Duration) */}
  <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-4">
    <div class="flex justify-between items-center">
      <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span class="text-sm">⏳</span> Time Horizon (Optional)
      </span>
      <span class="text-[10px] text-muted font-normal">Computes Annualized ROI (CAGR)</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-2">
        <label for="roi-duration-val" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span>Investment Duration</span>
          <span class="text-[10px] text-muted font-normal">Time Length</span>
        </label>
        <input 
          type="number" 
          id="roi-duration-val" 
          min="0" 
          step="any"
          placeholder="e.g. 3" 
          aria-describedby="duration-hint"
          class="w-full bg-surface-card border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm shadow-2xs" 
        />
        <p id="duration-hint" class="text-[11px] text-muted leading-tight">Leave blank for cumulative non-annualized ROI</p>
      </div>

      <div class="space-y-2">
        <label for="roi-duration-unit" class="text-xs font-semibold text-ink flex items-center justify-between">
          <span>Time Unit</span>
          <span class="text-[10px] text-muted font-normal">Scale</span>
        </label>
        <select 
          id="roi-duration-unit" 
          class="w-full bg-surface-card border border-hairline rounded-lg px-3.5 py-2.5 text-ink font-medium focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm shadow-2xs cursor-pointer"
        >
          <option value="years" selected>Years</option>
          <option value="months">Months</option>
        </select>
        <p class="text-[11px] text-muted leading-tight">Automatically converted to year fraction</p>
      </div>
    </div>
  </div>

  {/* Auto-Calculated Summary Panel */}
  <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span>⚡</span> Net Gain Summary
      </span>
      <span class="text-[10px] font-semibold text-muted bg-surface-strong px-2 py-0.5 rounded-md border border-hairline">Auto-Calculated</span>
    </div>
    
    <div class="flex items-center justify-between bg-surface-card border border-hairline rounded-lg p-3">
      <span class="text-xs text-muted font-medium">Net Profit / Investment Gain</span>
      <div class="flex items-center gap-1 font-mono font-bold text-sm">
        <span class="currency-symbol text-muted">$</span>
        <span id="roi-calc-net-gain-display" class="text-ink">0.00</span>
      </div>
    </div>
  </div>

  {/* Guidance Callout Box */}
  <div class="p-3.5 rounded-xl bg-canvas-soft border border-hairline-soft text-xs text-muted leading-relaxed flex items-start gap-2.5">
    <span class="text-base leading-none pt-0.5">💡</span>
    <div>
      <strong>Pro Tip:</strong> Simple ROI measures cumulative gain over the entire holding period. Inputting a duration unlocks <strong>Annualized ROI</strong>, allowing direct comparison against yearly asset benchmarks like the S&P 500.
    </div>
  </div>
</div>
