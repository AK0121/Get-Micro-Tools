---
---

<div class="p-5 sm:p-6 border-b border-hairline bg-canvas-soft flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">01. Analysis Mode</span>
    </div>
    <h2 class="text-base font-semibold text-ink">Calculation Engine</h2>
    <p class="text-xs text-muted">Select analysis framework for your investment or campaign</p>
  </div>
  <div 
    class="flex flex-wrap gap-2.5" 
    id="roi-mode-group" 
    role="radiogroup" 
    aria-label="ROI Calculation Mode Selector"
  >
    <button 
      type="button" 
      data-mode="standard" 
      class="roi-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-primary bg-primary/10 text-primary transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2 shadow-xs cursor-pointer"
      aria-checked="true"
      role="radio"
      tabindex="0"
    >
      <span>📈 Standard Investment ROI</span>
      <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-primary/20 font-bold uppercase tracking-wider">Capital & Assets</span>
    </button>
    <button 
      type="button" 
      data-mode="marketing" 
      class="roi-mode-btn min-h-[44px] px-4 py-2.5 text-xs font-semibold rounded-lg border border-hairline bg-surface-card text-muted hover:text-ink hover:border-hairline-strong transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 flex items-center gap-2 cursor-pointer"
      aria-checked="false"
      role="radio"
      tabindex="-1"
    >
      <span>🎯 Marketing & Campaign ROI</span>
      <span class="px-1.5 py-0.5 rounded-md text-[10px] bg-canvas-soft text-muted font-medium border border-hairline">Margin Integrated</span>
    </button>
  </div>
</div>
