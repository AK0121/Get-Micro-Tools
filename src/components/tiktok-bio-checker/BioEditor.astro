---
import { bioTemplates } from './checkerData';
---

<div class="lg:col-span-7 space-y-6">
  <!-- Section Title & Reset -->
  <div class="flex items-center justify-between border-b border-hairline-soft pb-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-primary">01. Bio Editor</span>
      <h3 class="text-sm font-semibold text-ink uppercase tracking-wider">TikTok Bio</h3>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <button 
        type="button" 
        id="clear-btn" 
        class="px-2.5 py-1 text-xs font-semibold text-muted hover:text-ink hover:bg-surface-strong rounded-md border border-hairline transition-all flex items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-2xs cursor-pointer"
        title="Clear bio text"
      >
        <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Clear Text</span>
      </button>
      <span class="text-[11px] text-muted font-medium hidden sm:flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span> Live Counter
      </span>
    </div>
  </div>

  <!-- Main Bio Textarea Box -->
  <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline space-y-4 shadow-2xs">
    <div class="flex items-center justify-between">
      <label for="bio-input" class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span>✍️</span> Bio Text
      </label>
      <span class="text-[11px] text-muted font-mono" id="char-status-pill">
        Max 80 Chars
      </span>
    </div>

    <div class="relative">
      <textarea
        id="bio-input"
        rows="4"
        maxlength="160"
        placeholder="Enter your TikTok bio here...&#10;e.g. 🎬 Creating daily tech tips & AI tutorials.&#10;👇 Grab my free creator toolkit below!"
        aria-describedby="bio-counters bio-warning-banner"
        class="w-full bg-surface-card border border-hairline rounded-lg p-3.5 text-ink font-sans text-base sm:text-base leading-relaxed placeholder:text-muted/60 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-y min-h-[120px] shadow-2xs"
      ></textarea>
    </div>

    <!-- Live Progress Bar -->
    <div class="space-y-1.5 pt-1">
      <div class="flex items-center justify-between text-[11px]">
        <span class="text-muted font-medium">Capacity Used</span>
        <span id="progress-percent" class="font-mono text-muted font-semibold">0% (0 / 80)</span>
      </div>
      <div class="w-full h-2.5 bg-surface-strong rounded-full overflow-hidden border border-hairline-soft" role="progressbar" id="bio-progress-bar-container" aria-valuenow="0" aria-valuemin="0" aria-valuemax="80">
        <div 
          id="progress-bar" 
          class="h-full bg-primary transition-all duration-150 rounded-full w-0"
        ></div>
      </div>
    </div>

    <!-- Live Stats Metrics Grid -->
    <div id="bio-counters" class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2" aria-live="polite">
      <!-- Characters Count -->
      <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
        <span class="text-[10px] font-semibold text-muted uppercase tracking-wider block">Characters</span>
        <div class="flex items-baseline gap-1">
          <span id="char-count" class="text-xl font-bold text-ink">0</span>
          <span class="text-xs text-muted font-mono">/ 80</span>
        </div>
      </div>

      <!-- Remaining Count -->
      <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
        <span class="text-[10px] font-semibold text-muted uppercase tracking-wider block">Remaining</span>
        <div class="flex items-baseline gap-1">
          <span id="remaining-count" class="text-xl font-bold text-emerald-600 dark:text-emerald-400">80</span>
          <span id="remaining-label" class="text-[10px] text-muted">left</span>
        </div>
      </div>

      <!-- Words Count -->
      <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
        <span class="text-[10px] font-semibold text-muted uppercase tracking-wider block">Words</span>
        <span id="word-count" class="text-xl font-bold text-ink block">0</span>
      </div>

      <!-- Lines Count -->
      <div class="p-3 bg-surface-card rounded-lg border border-hairline-soft space-y-1">
        <span class="text-[10px] font-semibold text-muted uppercase tracking-wider block">Lines</span>
        <span id="line-count" class="text-xl font-bold text-ink block">0</span>
      </div>
    </div>
  </div>

  <!-- Dynamic Warning / Alert Banner -->
  <div id="bio-warning-banner" class="hidden p-3.5 rounded-xl border text-xs space-y-1 transition-all" role="alert">
    <!-- Populated by CheckerScript.astro -->
  </div>

  <!-- Primary Action Buttons -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
    <button 
      type="button" 
      id="copy-bio-btn"
      class="w-full py-3 px-4 bg-primary hover:bg-primary-active text-white text-sm font-semibold rounded-md transition-all active:scale-[0.98] shadow-sm flex items-center justify-center gap-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary/40"
      title="Copy bio to clipboard"
    >
      <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
      </svg>
      <svg id="copy-success-icon" class="w-4 h-4 hidden text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span id="copy-btn-text">Copy Bio to Clipboard</span>
    </button>

    <button 
      type="button" 
      id="uppercase-first-btn"
      class="w-full py-3 px-4 bg-surface-card hover:bg-surface-strong text-ink border border-hairline text-sm font-semibold rounded-md transition-all active:scale-[0.98] shadow-2xs flex items-center justify-center gap-2 cursor-pointer focus:outline-none focus:ring-2 focus:ring-primary/20"
      title="Format line breaks and capitalize sentences"
    >
      <span>✨ Clean & Format</span>
    </button>
  </div>

  <!-- Quick Bio Inspiration Templates -->
  <div class="p-4 sm:p-5 rounded-xl bg-canvas-soft border border-hairline-soft space-y-3.5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-ink uppercase tracking-wider flex items-center gap-1.5">
        <span>💡</span> High-Converting Bio Templates
      </span>
      <span class="text-[10px] text-muted">Click to load</span>
    </div>

    <p class="text-[11px] text-muted leading-relaxed">
      Choose a proven 80-character template designed for maximum engagement and click-through rate:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      {bioTemplates.map((template) => (
        <button
          type="button"
          class="template-btn text-left p-2.5 bg-surface-card hover:bg-surface-strong/80 rounded-lg border border-hairline text-xs transition-all hover:border-hairline-strong focus:outline-none focus:ring-2 focus:ring-primary/30 group cursor-pointer"
          data-template={template.text}
        >
          <div class="flex items-center justify-between font-semibold text-ink mb-1">
            <span class="flex items-center gap-1.5">
              <span>{template.icon}</span>
              <span>{template.name}</span>
            </span>
            <span class="text-[10px] font-mono text-muted font-normal">{template.charCount} chars</span>
          </div>
          <p class="text-[11px] text-muted line-clamp-2 leading-relaxed whitespace-pre-line group-hover:text-ink transition-colors">
            {template.text}
          </p>
        </button>
      ))}
    </div>
  </div>

  <!-- Guidance Callout -->
  <div class="p-3.5 rounded-xl bg-canvas-soft border border-hairline-soft text-xs text-muted leading-relaxed flex items-start gap-2.5">
    <span class="text-base leading-none pt-0.5">📌</span>
    <div>
      <strong>TikTok Bio Tip:</strong> Line breaks count as 1 character each. Keep each line short and punchy, and always end your bio with a pointing-down emoji (👇) directed at your link.
    </div>
  </div>
</div>
