---
---

<div 
  class="lg:col-span-5 flex flex-col justify-between p-5 sm:p-6 bg-canvas-soft rounded-2xl border border-hairline space-y-6"
  role="region"
  aria-label="TikTok Live Profile Preview"
>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-hairline-soft pb-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">02. Live Preview</span>
        <h3 class="text-xs sm:text-sm font-semibold text-ink uppercase tracking-wider">TikTok Profile Mockup</h3>
      </div>
      <span id="preview-status-badge" class="px-2.5 py-1 rounded-pill bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold border border-emerald-500/20 shadow-2xs flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Fits Limits
      </span>
    </div>

    <!-- Phone Screen Mockup Container -->
    <div class="mx-auto w-full max-w-[340px] sm:max-w-[360px] bg-white dark:bg-[#121212] rounded-[32px] border-4 border-hairline-strong/60 shadow-xl overflow-hidden text-neutral-900 dark:text-white transition-colors">
      
      <!-- TikTok Top App Status / Nav Bar -->
      <div class="pt-3 px-4 pb-2 flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800/80">
        <div class="w-6 flex items-center justify-start text-neutral-600 dark:text-neutral-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </div>
        <div class="text-center font-bold text-sm tracking-tight flex items-center gap-1">
          <span id="preview-handle-header">alex.creator</span>
          <svg class="w-3.5 h-3.5 text-sky-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
          </svg>
        </div>
        <div class="w-6 flex items-center justify-end gap-2 text-neutral-600 dark:text-neutral-300">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
          </svg>
        </div>
      </div>

      <!-- Profile Avatar & Handle -->
      <div class="pt-4 pb-3 px-5 text-center flex flex-col items-center">
        <div class="relative mb-2">
          <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-amber-400 via-rose-500 to-indigo-600 p-[2.5px] shadow-sm">
            <div class="w-full h-full rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-2xl overflow-hidden select-none">
              <span id="preview-avatar-icon">🎬</span>
            </div>
          </div>
          <!-- Plus Icon Badge -->
          <div class="absolute bottom-0 right-0 w-6 h-6 rounded-full bg-[#fe2c55] text-white flex items-center justify-center border-2 border-white dark:border-[#121212] shadow-xs">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </div>
        </div>

        <h4 id="preview-display-name" class="font-bold text-base tracking-tight text-neutral-900 dark:text-white">
          Alex Rivera
        </h4>
        <p id="preview-handle" class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">
          @alex.creator
        </p>

        <!-- Stats Counts Row -->
        <div class="flex items-center justify-center gap-6 my-3.5 text-center">
          <div>
            <span class="block font-bold text-sm text-neutral-900 dark:text-white">184</span>
            <span class="text-[11px] text-neutral-500 dark:text-neutral-400">Following</span>
          </div>
          <div class="w-px h-6 bg-neutral-200 dark:bg-neutral-800"></div>
          <div>
            <span class="block font-bold text-sm text-neutral-900 dark:text-white">42.5K</span>
            <span class="text-[11px] text-neutral-500 dark:text-neutral-400">Followers</span>
          </div>
          <div class="w-px h-6 bg-neutral-200 dark:bg-neutral-800"></div>
          <div>
            <span class="block font-bold text-sm text-neutral-900 dark:text-white">680.2K</span>
            <span class="text-[11px] text-neutral-500 dark:text-neutral-400">Likes</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 w-full max-w-[260px] justify-center mb-3">
          <button type="button" class="flex-1 py-2 px-3 bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-xs font-semibold rounded-md transition-colors text-neutral-900 dark:text-white select-none">
            Edit profile
          </button>
          <button type="button" class="flex-1 py-2 px-3 bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-xs font-semibold rounded-md transition-colors text-neutral-900 dark:text-white select-none">
            Share profile
          </button>
          <button type="button" class="p-2 bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 rounded-md transition-colors select-none" aria-label="Bookmark">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
          </button>
        </div>

        <!-- BIO TEXT DISPLAY BOX -->
        <div class="w-full px-2 text-center my-1.5">
          <div 
            id="preview-bio-text" 
            class="text-xs sm:text-xs leading-relaxed text-neutral-800 dark:text-neutral-200 whitespace-pre-wrap break-words font-sans min-h-[40px] text-center"
          >
            <span class="text-neutral-400 dark:text-neutral-500 italic">Enter a bio in the editor to preview how it looks on your profile...</span>
          </div>

          <!-- Clickable Link in Bio -->
          <div id="preview-link-container" class="mt-2 flex items-center justify-center gap-1 text-[11px] font-semibold text-neutral-900 dark:text-white hover:underline cursor-pointer">
            <svg class="w-3 h-3 text-neutral-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span id="preview-link-text" class="truncate max-w-[200px]">beacons.ai/alex</span>
          </div>
        </div>

      </div>

      <!-- TikTok Feed Tab Icons -->
      <div class="border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-around py-2.5 text-neutral-400 dark:text-neutral-500">
        <div class="text-neutral-900 dark:text-white border-b-2 border-neutral-900 dark:border-white pb-1 px-3">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" />
          </svg>
        </div>
        <div class="pb-1 px-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div class="pb-1 px-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
        </div>
        <div class="pb-1 px-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
      </div>

      <!-- Video Grid Mockup -->
      <div class="grid grid-cols-3 gap-0.5 bg-neutral-100 dark:bg-neutral-800/50 pb-2">
        <div class="aspect-[3/4] bg-neutral-200 dark:bg-neutral-800 flex items-end p-1.5 relative">
          <span class="text-[9px] font-bold text-white drop-shadow flex items-center gap-0.5">
            ▶ 48.2K
          </span>
        </div>
        <div class="aspect-[3/4] bg-neutral-200 dark:bg-neutral-800 flex items-end p-1.5 relative">
          <span class="text-[9px] font-bold text-white drop-shadow flex items-center gap-0.5">
            ▶ 112K
          </span>
        </div>
        <div class="aspect-[3/4] bg-neutral-200 dark:bg-neutral-800 flex items-end p-1.5 relative">
          <span class="text-[9px] font-bold text-white drop-shadow flex items-center gap-0.5">
            ▶ 24.5K
          </span>
        </div>
      </div>
    </div>

    <!-- Mockup Customizer Options -->
    <div class="p-3.5 bg-surface-card rounded-xl border border-hairline-soft space-y-3">
      <span class="text-[11px] font-bold uppercase tracking-wider text-muted block">
        Customize Preview Mockup
      </span>
      <div class="grid grid-cols-2 gap-2.5">
        <div class="space-y-1">
          <label for="custom-handle" class="text-[10px] font-semibold text-muted">Username</label>
          <input 
            type="text" 
            id="custom-handle" 
            value="alex.creator"
            class="w-full bg-canvas-soft border border-hairline rounded px-2 py-1 text-xs text-ink focus:outline-none focus:border-primary" 
          />
        </div>
        <div class="space-y-1">
          <label for="custom-link" class="text-[10px] font-semibold text-muted">Website / Link</label>
          <input 
            type="text" 
            id="custom-link" 
            value="beacons.ai/alex"
            class="w-full bg-canvas-soft border border-hairline rounded px-2 py-1 text-xs text-ink focus:outline-none focus:border-primary" 
          />
        </div>
      </div>
    </div>

  </div>
</div>
